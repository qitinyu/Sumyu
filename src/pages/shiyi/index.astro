---
import Layout from '@layouts/Layout.astro';
import { COMMENT } from '@/config';

// 拾遗页面: 整个页面就是一个独立的 yuamli 留言区
// pageId='shiyi' 让拾遗的留言与其他页面/文章的留言完全隔离
const yuamliBaseUrl = COMMENT.yuamli.url;
const yuamliSeparator = yuamliBaseUrl.includes('?') ? '&' : '?';
const yuamliFrameSrc = yuamliBaseUrl + yuamliSeparator + 'pageId=shiyi';
---

<Layout title="拾遗 · 留言板" description="拾遗 · 留下你的足迹">
  <div class="container section-page shiyi-page">
    <header class="page-header">
      <div class="page-header__crumb">拾遗</div>
      <h1 class="page-header__title"><iconify-icon icon="mdi:email-edit-outline"></iconify-icon> 拾遗</h1>
      <p class="page-header__subtitle">留言板 · 愿你的足迹被这片拾遗记住</p>
    </header>

    <div class="shiyi-intro">
      <div class="shiyi-intro__envelope">
        <div class="shiyi-intro__letter">
          <h2><iconify-icon icon="mdi:hand-heart-outline" aria-hidden="true"></iconify-icon> 给 Sumyu 留句话</h2>
          <p>无论你来自哪里，无论你将去往何方，愿这里的留言成为我们相遇的见证。</p>
          <p class="shiyi-intro__note">
            <iconify-icon icon="mdi:information-outline" aria-hidden="true"></iconify-icon>
            支持 GitHub 登录与游客留言，留言支持 Markdown 语法。请文明留言，友善交流。
          </p>
        </div>
      </div>
    </div>

    {COMMENT.enable && COMMENT.system === 'yuamli' && (
      <div class="shiyi-comment-wrap">
        <iframe
          class="shiyi-comment-frame"
          id="shiyi-yuamli-frame"
          src={yuamliFrameSrc}
          loading="lazy"
          allow="fullscreen"
          title="拾遗留言板"
        ></iframe>
      </div>
    )}

    {!COMMENT.enable && (
      <div class="shiyi-disabled">
        <iconify-icon icon="mdi:comment-off-outline" aria-hidden="true"></iconify-icon>
        <h3>留言功能未开启</h3>
        <p>请在 <code>src/config.ts</code> 中设置 <code>COMMENT.enable = true</code> 并配置 yuamli 评论系统。</p>
      </div>
    )}

    {COMMENT.enable && COMMENT.system !== 'yuamli' && (
      <div class="shiyi-disabled">
        <iconify-icon icon="mdi:comment-alert-outline" aria-hidden="true"></iconify-icon>
        <h3>当前评论系统不是 yuamli</h3>
        <p>拾遗页面专为 yuamli 留言系统设计，请在 <code>src/config.ts</code> 中设置 <code>COMMENT.system = 'yuamli'</code>。</p>
        <p>当前系统: <code>{COMMENT.system}</code></p>
      </div>
    )}
  </div>
</Layout>

<style>
  .shiyi-page { padding: 32px 24px 40px; max-width: 820px; }
  .page-header { margin-bottom: 28px; text-align: center; }
  .page-header__crumb { font-size: 12px; color: var(--text-muted); letter-spacing: 0.1em; margin-bottom: 6px; }
  .page-header__title { font-size: 28px; color: var(--text-strong); display: inline-flex; align-items: center; gap: 8px; }
  .page-header__title iconify-icon { color: var(--sakura-primary); }
  .page-header__subtitle { color: var(--text-muted); font-size: 13px; margin-top: 8px; }

  /* 引言卡片: 信封风格 */
  .shiyi-intro { margin-bottom: 28px; }
  .shiyi-intro__envelope {
    background: var(--sakura-primary-bg);
    border: 1px solid var(--sakura-primary-soft);
    border-radius: var(--radius-lg);
    padding: 4px;
    box-shadow: var(--shadow-sm);
  }
  .shiyi-intro__letter {
    background: var(--bg-card);
    border-radius: var(--radius-md);
    padding: 24px 28px;
  }
  .shiyi-intro__letter h2 {
    font-size: 18px; color: var(--sakura-primary);
    margin-bottom: 10px;
    display: inline-flex; align-items: center; gap: 6px;
  }
  .shiyi-intro__letter h2 iconify-icon { font-size: 22px; }
  .shiyi-intro__letter > p {
    font-size: 14px; color: var(--text-muted);
    line-height: 1.8; margin-bottom: 8px;
  }
  .shiyi-intro__note {
    display: flex; align-items: flex-start; gap: 6px;
    font-size: 12px !important;
    color: var(--text-faint) !important;
    margin-top: 14px;
    padding: 10px 14px;
    background: var(--bg-soft);
    border-radius: var(--radius-sm);
    line-height: 1.6;
  }
  .shiyi-intro__note iconify-icon {
    font-size: 16px; flex-shrink: 0; margin-top: 1px;
    color: var(--sakura-primary-soft);
  }

  /* yuamli iframe 留言区: 整页主体 */
  .shiyi-comment-wrap {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .shiyi-comment-frame {
    width: 100%;
    min-height: 700px;
    border: none;
    display: block;
  }

  /* 未启用 / 非 yuamli 系统提示 */
  .shiyi-disabled {
    text-align: center;
    padding: 60px 24px;
    color: var(--text-muted);
  }
  .shiyi-disabled iconify-icon {
    font-size: 56px;
    color: var(--sakura-primary-soft);
    margin-bottom: 14px;
  }
  .shiyi-disabled h3 {
    font-size: 18px;
    color: var(--text-strong);
    margin-bottom: 10px;
  }
  .shiyi-disabled p {
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 6px;
  }
  .shiyi-disabled code {
    background: var(--bg-soft); padding: 2px 8px; border-radius: 4px;
    font-size: 12px; color: var(--sakura-primary);
  }

  @media (max-width: 768px) {
    .shiyi-page { padding: 24px 16px 40px; }
    .shiyi-intro__letter { padding: 18px 20px; }
    .shiyi-comment-frame { min-height: 600px; }
  }
</style>
