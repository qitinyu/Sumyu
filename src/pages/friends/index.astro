---
import Layout from '@layouts/Layout.astro';
import { rssFriends } from '@/data/rss';
import { fetchAllFriendArticles } from '@/utils/rss-parser';

const hasFriends = rssFriends.length > 0;
const friendsWithFeed = rssFriends.filter(f => f.feed && f.feed.trim());

// 构建时从友链 RSS feed 直接拉取文章 (无需客户端代理)
const friendArticles = friendsWithFeed.length > 0
  ? await fetchAllFriendArticles(friendsWithFeed, 3)
  : [];
const hasArticles = friendArticles.length > 0;
const successCount = new Set(friendArticles.map(a => a.name)).size;
---

<Layout title="石径 · 友链最新文章" description="石径 · 友链 RSS 朋友圈 · 汇聚友邻博客最新文章">
  <div class="container section-page">
    <header class="page-header">
      <div class="page-header__crumb">萍踪 / 石径</div>
      <h1 class="page-header__title"><iconify-icon icon="mdi:rss"></iconify-icon> 石径</h1>
      <p class="page-header__subtitle">友链最新文章 · 如石径通幽, 见友邻所言</p>
    </header>

    <section class="info-section">
      <h2><iconify-icon icon="mdi:rss" aria-hidden="true"></iconify-icon> RSS 朋友圈</h2>
      <p>本博客提供 RSS 订阅源：<a href="/rss.xml">/rss.xml</a></p>
      <p>「石径」汇聚已订阅友邻博客的最新文章列表, 一站式浏览友人的所思所写。如需加入, 可在留言板或邮件联系本站。</p>
      {hasFriends ? (
        <ul class="rss-friends">
          {rssFriends.map(f => (
            <li>
              <a href={f.url} target="_blank" rel="noopener">
                <img src={f.avatar} alt={f.name} loading="lazy" referrerpolicy="no-referrer" class="rss-friends__avatar" />
                {f.name}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rss-empty">暂无订阅 · 等待友邻加入</p>
      )}
    </section>

    <section class="info-section">
      <h2><iconify-icon icon="mdi:note-text-outline" aria-hidden="true"></iconify-icon> 最新文章</h2>
      {friendsWithFeed.length === 0 ? (
        <p class="rss-empty">暂无 RSS 订阅源 · 请在 <code>src/data/rss.ts</code> 的 <code>rssFriends</code> 中添加友链 RSS 地址。</p>
      ) : hasArticles && (
        <p class="rss-summary">共加载 {friendArticles.length} 篇文章 (来自 {successCount} 个友邻, {friendsWithFeed.length - successCount} 个失败)</p>
      )}
      <div class="rss-feed-list">
        {hasArticles ? (
          friendArticles.map(it => (
            <a class="rss-feed-item" href={it.articleUrl} target="_blank" rel="noopener">
              <div class="rss-feed-item__avatar"><img src={it.avatar} alt={it.name} loading="lazy" referrerpolicy="no-referrer" onerror="this.style.display='none'" /></div>
              <div class="rss-feed-item__body">
                <div class="rss-feed-item__title">{it.title}</div>
                <div class="rss-feed-item__meta"><span>{it.name}</span>{it.date ? <span>· {it.date}</span> : ''}</div>
              </div>
            </a>
          ))
        ) : (
          <p class="rss-empty">暂未能加载任何文章 · 请稍后重试</p>
        )}
      </div>
    </section>
  </div>
</Layout>

<style>
  .section-page { padding: 32px 24px 60px; max-width: 880px; }
  .page-header { margin-bottom: 28px; }
  .page-header__crumb { font-size: 12px; color: var(--text-muted); letter-spacing: 0.1em; margin-bottom: 6px; }
  .page-header__title { font-size: 28px; color: var(--text-strong); display: inline-flex; align-items: center; gap: 8px; }
  .page-header__title iconify-icon { color: var(--sakura-primary); }
  .page-header__subtitle { color: var(--text-muted); font-size: 13px; margin-top: 8px; }

  .info-section {
    background: var(--bg-card); border: 1px solid var(--border-color);
    border-radius: var(--radius-lg); padding: 22px 26px; margin-bottom: 18px;
  }
  .info-section h2 { font-size: 17px; color: var(--text-strong); margin-bottom: 12px; display: inline-flex; align-items: center; gap: 6px; }
  .info-section h2 iconify-icon { color: var(--sakura-primary); }
  .info-section p { font-size: 14px; color: var(--text-base); line-height: 1.9; margin-bottom: 6px; }
  .info-section code { background: var(--bg-soft); padding: 2px 6px; border-radius: 4px; font-size: 12px; color: var(--sakura-primary); }

  /* 友链列表: 带头像 */
  .rss-friends { padding-left: 0; margin: 8px 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .rss-friends li { padding: 0; }
  .rss-friends a {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--text-base); font-size: 13px;
    padding: 4px 12px 4px 4px;
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }
  .rss-friends a:hover { border-color: var(--sakura-primary-soft); color: var(--sakura-primary); }
  .rss-friends__avatar {
    width: 24px; height: 24px; border-radius: 50%;
    object-fit: cover; flex-shrink: 0;
  }

  .rss-empty { color: var(--text-muted); font-size: 13px; padding: 12px 0; }
  .rss-summary { color: var(--text-faint); font-size: 12px; margin-bottom: 10px; }

  .rss-feed-list { display: flex; flex-direction: column; gap: 10px; }
  .rss-feed-item {
    display: flex; gap: 12px; padding: 12px 14px;
    background: var(--bg-soft); border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    transition: all var(--transition-fast);
    color: inherit;
  }
  .rss-feed-item:hover { border-color: var(--sakura-primary-soft); transform: translateX(2px); }
  .rss-feed-item__avatar { width: 36px; height: 36px; flex-shrink: 0; border-radius: 50%; overflow: hidden; border: 1px solid var(--border-color); background: var(--bg-card); }
  .rss-feed-item__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .rss-feed-item__body { flex: 1; min-width: 0; }
  .rss-feed-item__title { font-size: 14px; color: var(--text-strong); line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .rss-feed-item__meta { font-size: 12px; color: var(--text-muted); margin-top: 4px; display: flex; gap: 8px; }
</style>
