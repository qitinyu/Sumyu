---
import Layout from '@layouts/Layout.astro';
import { getPublishedDiary, formatDate } from '@/utils/posts';
import { DIARY_PAGE_SIZE } from '@/config';

const allDiary = await getPublishedDiary();
const totalPages = Math.max(1, Math.ceil(allDiary.length / DIARY_PAGE_SIZE));
---

<Layout title="踏青 · 日记" description="踏青 · Sumyu 的日常日记">
  <div class="container section-page">
    <header class="page-header">
      <div class="page-header__crumb">尺素 / 踏青</div>
      <h1 class="page-header__title"><iconify-icon icon="mdi:notebook-outline"></iconify-icon> 踏青</h1>
      <p class="page-header__subtitle">日记 · 朝夕暮晚的随笔</p>
    </header>

    {allDiary.length === 0 ? (
      <div class="empty-state">
        <iconify-icon icon="mdi:feather" aria-hidden="true"></iconify-icon>
        <p>暂无日记 · 在 src/content/diary/ 添加 Markdown 即可</p>
      </div>
    ) : (
      <Fragment>
        <div class="diary-grid" id="diary-list">
          {allDiary.map((d, i) => (
            <article class="diary-card" data-page={Math.floor(i / DIARY_PAGE_SIZE) + 1}>
              <a class="diary-card__link" href={`/diary/${d.id}/`}></a>
              <div class="diary-card__date">
                <iconify-icon icon="mdi:calendar-outline" aria-hidden="true"></iconify-icon>
                {formatDate(d.data.pubDate)}
              </div>
              <h2 class="diary-card__title">{d.data.title}</h2>
              {d.data.description && (
                <p class="diary-card__excerpt">{d.data.description}</p>
              )}
              {d.data.tags.length > 0 && (
                <div class="diary-card__tags">
                  {d.data.tags.slice(0, 3).map(t => (
                    <span class="diary-card__tag">#{t}</span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>

        {totalPages > 1 && (
          <nav class="diary-pagination" id="diary-pagination" data-total-pages={totalPages} data-page-size={DIARY_PAGE_SIZE}>
            <button type="button" class="diary-pagination__btn" id="diary-prev">← 上一页</button>
            <div class="diary-pagination__pages" id="diary-page-numbers">
              {Array.from({ length: totalPages }, (_, i) => i + 1).map(n => (
                <button type="button" class={`diary-pagination__page${n === 1 ? ' is-active' : ''}`} data-page={n}>{n}</button>
              ))}
            </div>
            <button type="button" class="diary-pagination__btn" id="diary-next">下一页 →</button>
          </nav>
        )}
      </Fragment>
    )}
  </div>
</Layout>

<script>
  function initDiaryPagination() {
    const pagination = document.getElementById('diary-pagination');
    if (!pagination) return;

    const total = parseInt(pagination.dataset.totalPages || '1', 10);
    const items = document.querySelectorAll('#diary-list .diary-card');
    const pageNumBtns = pagination.querySelectorAll('.diary-pagination__page');
    const prevBtn = document.getElementById('diary-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('diary-next') as HTMLButtonElement | null;
    const pageHeader = document.querySelector('.page-header') as HTMLElement | null;
    let currentPage = 1;

    function goTo(page: number, scroll = true) {
      page = Math.min(Math.max(1, page), total);
      currentPage = page;
      items.forEach(item => {
        const p = parseInt(item.getAttribute('data-page') || '1', 10);
        (item as HTMLElement).style.display = p === page ? '' : 'none';
      });
      pageNumBtns.forEach(btn => {
        const p = parseInt(btn.getAttribute('data-page') || '1', 10);
        btn.classList.toggle('is-active', p === page);
      });
      if (prevBtn) prevBtn.disabled = page <= 1;
      if (nextBtn) nextBtn.disabled = page >= total;
      if (scroll) pageHeader?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    pagination.addEventListener('click', (e) => {
      const pageBtn = e.target.closest('.diary-pagination__page');
      if (pageBtn) {
        goTo(parseInt(pageBtn.getAttribute('data-page') || '1', 10));
        return;
      }
      if (e.target.closest('#diary-prev')) {
        goTo(currentPage - 1);
        return;
      }
      if (e.target.closest('#diary-next')) {
        goTo(currentPage + 1);
        return;
      }
    });

    goTo(1, false);
  }
  initDiaryPagination();
  document.addEventListener('astro:page-load', initDiaryPagination);
</script>

<style>
  .section-page { padding: 32px 24px 60px; max-width: var(--container-max); }
  .page-header { margin-bottom: 28px; }
  .page-header__crumb { font-size: 12px; color: var(--text-muted); letter-spacing: 0.1em; margin-bottom: 6px; }
  .page-header__title { font-size: 28px; color: var(--text-strong); display: inline-flex; align-items: center; gap: 8px; }
  .page-header__title iconify-icon { color: var(--sakura-primary); }
  .page-header__subtitle { color: var(--text-muted); font-size: 13px; margin-top: 8px; }

  .empty-state { text-align: center; padding: 60px 24px; color: var(--text-muted); }
  .empty-state iconify-icon { font-size: 48px; color: var(--sakura-primary-soft); margin-bottom: 12px; }

  /* 日记卡片网格 */
  .diary-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .diary-card {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 20px 22px;
    display: flex; flex-direction: column; gap: 8px;
    transition: all var(--transition-base);
    overflow: hidden;
  }
  .diary-card:hover {
    transform: translateY(-3px);
    border-color: var(--sakura-primary-soft);
    box-shadow: var(--shadow-pink);
  }
  .diary-card__link { position: absolute; inset: 0; z-index: 2; }
  .diary-card__date {
    font-size: 12px; color: var(--text-muted);
    display: inline-flex; align-items: center; gap: 4px;
  }
  .diary-card__title {
    font-size: 18px; color: var(--text-strong); line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    transition: color var(--transition-fast);
  }
  .diary-card:hover .diary-card__title { color: var(--sakura-primary); }
  .diary-card__excerpt {
    font-size: 13px; color: var(--text-muted); line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .diary-card__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .diary-card__tag {
    font-size: 11px; color: var(--sakura-primary);
    background: var(--sakura-primary-bg);
    padding: 2px 8px; border-radius: var(--radius-full);
  }

  /* 分页 */
  .diary-pagination {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    margin-top: 40px;
  }
  .diary-pagination__btn {
    padding: 8px 18px; border-radius: var(--radius-full);
    border: 1px solid var(--border-color); color: var(--text-base);
    font-size: 13px; transition: all var(--transition-fast);
    cursor: pointer; background: transparent;
  }
  .diary-pagination__btn:hover:not(:disabled) { border-color: var(--sakura-primary); color: var(--sakura-primary); }
  .diary-pagination__btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .diary-pagination__pages { display: flex; gap: 6px; }
  .diary-pagination__page {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    color: var(--text-muted); font-size: 13px; cursor: pointer;
    transition: all var(--transition-fast); background: transparent;
  }
  .diary-pagination__page:hover { color: var(--sakura-primary); background: var(--sakura-primary-bg); }
  .diary-pagination__page.is-active { background: var(--sakura-primary); color: #fff; }

  @media (max-width: 768px) {
    .diary-grid { grid-template-columns: 1fr; }
    .diary-card__title { font-size: 16px; }
  }
</style>