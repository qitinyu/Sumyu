---
import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import NoticeBoard from '@components/NoticeBoard.astro';
import BlogPostCard from '@components/BlogPostCard.astro';
import { getPublishedPosts, getTags } from '@/utils/posts';
import { POSTS_PAGE_SIZE } from '@/config';

const allPosts = await getPublishedPosts();
const tags = await getTags();
// 置顶文章优先排序: pinned: true 的文章排到最前, 其余按 pubDate 倒序
const sortedPosts = [...allPosts].sort((a, b) => {
  const ap = a.data.pinned ? 1 : 0;
  const bp = b.data.pinned ? 1 : 0;
  if (ap !== bp) return bp - ap;
  return b.data.pubDate.getTime() - a.data.pubDate.getTime();
});
const totalPages = Math.max(1, Math.ceil(sortedPosts.length / POSTS_PAGE_SIZE));
---

<Layout isHome title="Sumyu" description="Sumyu 的个人博客 · 轩窗听雨">
  <Hero />

  <section class="home-posts" id="home-posts">
    <div class="container">
      <!-- 公告栏 + 随机轮播文章 + 站点统计 -->
      <div class="home-posts__notice">
        <NoticeBoard randomPosts={sortedPosts} />
      </div>

      <header class="home-posts__head" id="posts-head">
        <div class="home-posts__head-left">
          <h2 class="home-posts__title">
            <iconify-icon icon="ant-design:read-filled" aria-hidden="true"></iconify-icon>
            博文
          </h2>
          {tags.length > 0 && (
            <nav class="home-tags" id="home-tags" aria-label="按标签筛选文章">
              {tags.map((t) => (
                <button
                  type="button"
                  class="home-tag"
                  data-tag={t.name}
                  title={`只看「${t.name}」下的 ${t.count} 篇文章`}
                >
                  <iconify-icon icon="mdi:tag" aria-hidden="true"></iconify-icon>
                  <span class="home-tag__name">{t.name}</span>
                  <span class="home-tag__count">{t.count}</span>
                </button>
              ))}
            </nav>
          )}
        </div>
        <span class="home-posts__count" id="posts-count">
          <span id="posts-count-main">共 {sortedPosts.length} 篇</span>
          <span id="posts-count-page">· 第 <span id="page-current">1</span> / {totalPages} 页</span>
          <button type="button" class="home-tags__clear" id="tag-clear" hidden>清除筛选</button>
        </span>
      </header>

      <div class="home-posts__list" id="posts-list">
        {sortedPosts.map((post, i) => (
          <div
            class="post-page-item"
            data-page={Math.floor(i / POSTS_PAGE_SIZE) + 1}
            data-tags={post.data.tags.join('|')}
          >
            <BlogPostCard post={post} />
          </div>
        ))}
      </div>

      <p class="home-posts__empty" id="posts-empty" hidden>没有找到带有该标签的文章</p>

      {totalPages > 1 && (
        <nav class="home-pagination" id="home-pagination" data-total-pages={totalPages} data-page-size={POSTS_PAGE_SIZE}>
          <button type="button" class="home-pagination__btn" id="page-prev">← 上一页</button>
          <div class="home-pagination__pages" id="page-numbers">
            {Array.from({ length: totalPages }, (_, i) => i + 1).map(n => (
              <button type="button" class={`home-pagination__page${n === 1 ? ' is-active' : ''}`} data-page={n}>{n}</button>
            ))}
          </div>
          <button type="button" class="home-pagination__btn" id="page-next">下一页 →</button>
        </nav>
      )}
    </div>
  </section>
</Layout>

<script>
  // 首页博文区: 分页 + 标签就地筛选（同一份 DOM，不跳转）
  function initHomePosts() {
    const list = document.getElementById('posts-list');
    const sectionHeader = document.getElementById('posts-head');
    if (!list || list.dataset.inited === '1') return;
    list.dataset.inited = '1';

    const items = Array.from(list.querySelectorAll<HTMLElement>('.post-page-item'));
    const totalPosts = items.length;
    const pagination = document.getElementById('home-pagination');
    const totalPages = pagination ? parseInt(pagination.dataset.totalPages || '1', 10) || 1 : 1;
    const pageNumBtns = pagination ? Array.from(pagination.querySelectorAll<HTMLElement>('.home-pagination__page')) : [];
    const prevBtn = document.getElementById('page-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('page-next') as HTMLButtonElement | null;
    const currentLabel = document.getElementById('page-current');
    const countMain = document.getElementById('posts-count-main');
    const countPage = document.getElementById('posts-count-page');
    const tagBox = document.getElementById('home-tags');
    const tagBtns = tagBox ? Array.from(tagBox.querySelectorAll<HTMLElement>('.home-tag')) : [];
    const clearBtn = document.getElementById('tag-clear') as HTMLButtonElement | null;
    const emptyTip = document.getElementById('posts-empty');

    let currentPage = 1;
    let activeTag = '';

    function syncUrl() {
      const url = new URL(window.location.href);
      if (activeTag) {
        url.searchParams.set('tag', activeTag);
        url.searchParams.delete('page');
      } else {
        url.searchParams.delete('tag');
        if (currentPage > 1) url.searchParams.set('page', String(currentPage));
        else url.searchParams.delete('page');
      }
      history.replaceState(null, '', url.toString());
    }

    function renderPage(page: number) {
      currentPage = Math.min(Math.max(1, page), totalPages);
      items.forEach(item => {
        const p = parseInt(item.getAttribute('data-page') || '1', 10);
        item.style.display = p === currentPage ? '' : 'none';
      });
      pageNumBtns.forEach(btn => {
        btn.classList.toggle('is-active', parseInt(btn.getAttribute('data-page') || '1', 10) === currentPage);
      });
      if (currentLabel) currentLabel.textContent = String(currentPage);
      if (prevBtn) prevBtn.disabled = currentPage <= 1;
      if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
    }

    function applyTag(tag: string) {
      activeTag = tag;
      tagBtns.forEach(btn => {
        const on = btn.dataset.tag === activeTag;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      if (clearBtn) clearBtn.hidden = !activeTag;

      if (!activeTag) {
        if (pagination) pagination.hidden = false;
        if (countPage) countPage.hidden = false;
        if (countMain) countMain.textContent = `共 ${totalPosts} 篇`;
        if (emptyTip) emptyTip.hidden = true;
        renderPage(currentPage);
      } else {
        let shown = 0;
        items.forEach(item => {
          const hit = (item.getAttribute('data-tags') || '').split('|').includes(activeTag);
          item.style.display = hit ? '' : 'none';
          if (hit) shown++;
        });
        if (pagination) pagination.hidden = true;
        if (countPage) countPage.hidden = true;
        if (countMain) countMain.textContent = `「${activeTag}」共 ${shown} 篇`;
        if (emptyTip) emptyTip.hidden = shown !== 0;
      }
      syncUrl();
    }

    // ---- 初始化: 支持 ?tag= 与 ?page= 深链 ----
    const params = new URLSearchParams(window.location.search);
    const urlTag = params.get('tag') || '';
    const urlPage = parseInt(params.get('page') || '1', 10);
    renderPage(urlPage > 1 && urlPage <= totalPages ? urlPage : 1);
    if (urlTag && tagBtns.some(btn => btn.dataset.tag === urlTag)) {
      applyTag(urlTag);
    }

    // ---- 标签点击: 就地筛选, 再点一次取消 ----
    tagBox?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.home-tag');
      if (!btn || !btn.dataset.tag) return;
      applyTag(btn.dataset.tag === activeTag ? '' : btn.dataset.tag);
      const rect = sectionHeader?.getBoundingClientRect();
      if (rect && (rect.top < 0 || rect.top > window.innerHeight * 0.55)) {
        sectionHeader?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
    clearBtn?.addEventListener('click', () => applyTag(''));

    // ---- 卡片上的 #标签 也走就地筛选, 不再跳转到标签页 ----
    list.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.blog-card__tag');
      if (!link) return;
      const matched = (link.getAttribute('href') || '').match(/[?&]tag=([^&]+)/);
      if (!matched) return;
      const tag = decodeURIComponent(matched[1]);
      if (!tagBtns.some(btn => btn.dataset.tag === tag)) return;
      e.preventDefault();
      applyTag(tag);
      const rect = sectionHeader?.getBoundingClientRect();
      if (rect && (rect.top < 0 || rect.top > window.innerHeight * 0.55)) {
        sectionHeader?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // ---- 分页 ----
    pagination?.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const pageBtn = target.closest<HTMLElement>('.home-pagination__page');
      if (pageBtn) {
        renderPage(parseInt(pageBtn.getAttribute('data-page') || '1', 10));
        syncUrl();
        sectionHeader?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (target.closest('#page-prev')) {
        renderPage(currentPage - 1);
        syncUrl();
        sectionHeader?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      if (target.closest('#page-next')) {
        renderPage(currentPage + 1);
        syncUrl();
        sectionHeader?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
  initHomePosts();
  document.addEventListener('astro:page-load', initHomePosts);

  // 博文布局初始化：从 localStorage 读取并应用
  function initPostLayout() {
    const layout = localStorage.getItem('sumyu-post-layout') || 'list';
    const list = document.getElementById('posts-list');
    if (list) list.classList.toggle('is-grid', layout === 'grid');
  }
  initPostLayout();
  document.addEventListener('astro:page-load', initPostLayout);
</script>

<style>
  .home-posts { padding: 40px 24px 60px; }
  .home-posts__notice { margin-bottom: 40px; }
  .home-posts__head {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px 20px;
    margin-bottom: 24px; padding-bottom: 12px;
    border-bottom: 1px solid var(--border-color);
    scroll-margin-top: calc(var(--navbar-height, 60px) + 16px);
  }
  .home-posts__head-left {
    display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; min-width: 0;
  }
  .home-posts__title {
    font-size: 24px; color: var(--text-strong);
    display: inline-flex; align-items: center; gap: 8px;
  }
  .home-posts__title iconify-icon { color: var(--sakura-primary); }
  .home-posts__count {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 13px; color: var(--text-muted); margin-left: auto;
  }

  /* 博文标题后的标签行: 标签 × 文章数, 点击就地筛选文章列表 */
  .home-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .home-tag {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px; border-radius: var(--radius-full);
    background: var(--bg-soft); border: 1px solid var(--border-color);
    color: var(--text-muted); font-size: 12px; line-height: 1.6;
    font-family: inherit; cursor: pointer;
    transition: all var(--transition-fast);
  }
  .home-tag iconify-icon { font-size: 12px; color: var(--sakura-primary); opacity: 0.7; }
  .home-tag__count {
    font-size: 11px; color: var(--sakura-primary);
    background: var(--sakura-primary-bg); border-radius: 8px;
    padding: 0 5px; margin-left: 1px;
    transition: all var(--transition-fast);
  }
  .home-tag:hover {
    color: var(--sakura-primary); border-color: var(--sakura-primary-soft);
    background: var(--sakura-primary-bg); transform: translateY(-1px);
  }
  .home-tag:hover iconify-icon { opacity: 1; }
  .home-tag.is-active {
    color: #fff; background: var(--sakura-primary);
    border-color: var(--sakura-primary);
    box-shadow: 0 2px 8px rgba(223, 145, 147, 0.35);
  }
  .home-tag.is-active iconify-icon { color: #fff; opacity: 1; }
  .home-tag.is-active .home-tag__count { color: var(--sakura-primary); background: #fff; }

  .home-tags__clear {
    padding: 2px 10px; border-radius: var(--radius-full);
    border: 1px dashed var(--border-color); background: transparent;
    color: var(--text-muted); font-size: 12px; font-family: inherit;
    cursor: pointer; transition: all var(--transition-fast);
  }
  .home-tags__clear:hover { color: var(--sakura-primary); border-color: var(--sakura-primary); }

  .home-posts__empty {
    padding: 48px 0; text-align: center;
    color: var(--text-muted); font-size: 14px;
  }

  .home-posts__list { display: flex; flex-direction: column; gap: 14px; }

  /* 网格模式 */
  .home-posts__list.is-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .home-pagination {
    display: flex; align-items: center; justify-content: center; gap: 14px;
    margin-top: 40px;
  }
  .home-pagination[hidden] { display: none; }
  .home-pagination__btn {
    padding: 8px 18px; border-radius: var(--radius-full);
    border: 1px solid var(--border-color); color: var(--text-base);
    font-size: 13px; transition: all var(--transition-fast);
    cursor: pointer; background: transparent;
  }
  .home-pagination__btn:hover:not(:disabled) { border-color: var(--sakura-primary); color: var(--sakura-primary); }
  .home-pagination__btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .home-pagination__pages { display: flex; gap: 6px; }
  .home-pagination__page {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    color: var(--text-muted); font-size: 13px; cursor: pointer;
    transition: all var(--transition-fast); background: transparent;
  }
  .home-pagination__page:hover { color: var(--sakura-primary); background: var(--sakura-primary-bg); }
  .home-pagination__page.is-active { background: var(--sakura-primary); color: #fff; }

  @media (max-width: 768px) {
    .home-posts { padding: 24px 16px 40px; }
    .home-posts__notice { margin-bottom: 28px; }
    .home-posts__list.is-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
