---
import Layout from '@layouts/Layout.astro';
import BlogPostCard from '@components/BlogPostCard.astro';
import { getPublishedPosts } from '@/utils/posts';

const posts = await getPublishedPosts();
---

<Layout title="博文" description="Sumyu · 全部文章">
  <div class="container posts-page">
    <header class="page-header">
      <h1 class="page-header__title"><iconify-icon icon="ant-design:read-filled" aria-hidden="true"></iconify-icon> 博文</h1>
      <p class="page-header__subtitle">共 {posts.length} 篇文章 · 让文字记录生活</p>
    </header>

    <div class="post-list-container">
      {posts.map(post => <BlogPostCard post={post} />)}
    </div>
  </div>
</Layout>

<style>
  .posts-page { padding: 32px 24px 40px; max-width: 1080px; }
  .page-header { margin-bottom: 28px; text-align: center; }
  .page-header__title { font-size: 28px; color: var(--text-strong); display: inline-flex; align-items: center; gap: 8px; }
  .page-header__title iconify-icon { color: var(--sakura-primary); }
  .page-header__subtitle { color: var(--text-muted); font-size: 13px; margin-top: 8px; }
  .post-list-container { display: flex; flex-direction: column; gap: 14px; }
</style>
