---
import Layout from '@layouts/Layout.astro';
import Comment from '@components/Comment.astro';
import { getPublishedPosts, getPostNeighbors, formatDate, readingTime } from '@/utils/posts';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content } = await render(post);

const { prev, next } = await getPostNeighbors(post.id);
const cover = post.data.image || '';
const minutes = (post.data as any).readingMinutes ?? 3;
const isEncrypted = post.data.encrypted;
const author = post.data.author;
const licenseName = post.data.licenseName;
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="post-detail container">
    {cover && (
      <header class="post-header">
        <div class="post-header__cover">
          <img src={cover} alt={post.data.title} />
          <div class="post-header__overlay"></div>
        </div>
        <div class="post-header__info">
          <div class="post-header__categories">
            <a href={`/categories/?category=${encodeURIComponent(post.data.category)}`}>
              <iconify-icon icon="mdi:folder-open-outline" aria-hidden="true"></iconify-icon>
              {post.data.category}
            </a>
          </div>
          <h1 class="post-header__title">{post.data.title}</h1>
          <div class="post-header__meta">
            <span><iconify-icon icon="mdi:calendar-outline" aria-hidden="true"></iconify-icon> {formatDate(post.data.pubDate)}</span>
            {post.data.updatedDate && (
              <span><iconify-icon icon="mdi:update" aria-hidden="true"></iconify-icon> {formatDate(post.data.updatedDate)}</span>
            )}
            <span><iconify-icon icon="mdi:clock-outline" aria-hidden="true"></iconify-icon> {readingTime(minutes)}</span>
            <span><iconify-icon icon="mdi:account-outline" aria-hidden="true"></iconify-icon> {author}</span>
            {isEncrypted && (
              <span class="post-header__lock"><iconify-icon icon="mdi:lock" aria-hidden="true"></iconify-icon> 加密文章</span>
            )}
          </div>
          {post.data.tags.length > 0 && (
            <div class="post-header__tags">
              {post.data.tags.map((t) => (
                <a href={`/tags/?tag=${encodeURIComponent(t)}`} class="post-tag">
                  <iconify-icon icon="mdi:tag" aria-hidden="true"></iconify-icon>
                  {t}
                </a>
              ))}
            </div>
          )}
        </div>
      </header>
    )}

    {!cover && (
      <header class="post-header-text">
        <div class="post-header__categories">
          <a href={`/categories/?category=${encodeURIComponent(post.data.category)}`}>
            <iconify-icon icon="mdi:folder-open-outline" aria-hidden="true"></iconify-icon>
            {post.data.category}
          </a>
        </div>
        <h1 class="post-header__title-text">{post.data.title}</h1>
        <div class="post-header__meta">
          <span><iconify-icon icon="mdi:calendar-outline" aria-hidden="true"></iconify-icon> {formatDate(post.data.pubDate)}</span>
          {post.data.updatedDate && (
            <span><iconify-icon icon="mdi:update" aria-hidden="true"></iconify-icon> {formatDate(post.data.updatedDate)}</span>
          )}
          <span><iconify-icon icon="mdi:clock-outline" aria-hidden="true"></iconify-icon> {readingTime(minutes)}</span>
          <span><iconify-icon icon="mdi:account-outline" aria-hidden="true"></iconify-icon> {author}</span>
          {isEncrypted && (
            <span class="post-header__lock"><iconify-icon icon="mdi:lock" aria-hidden="true"></iconify-icon> 加密文章</span>
          )}
        </div>
        {post.data.tags.length > 0 && (
          <div class="post-header__tags">
            {post.data.tags.map((t) => (
              <a href={`/tags/?tag=${encodeURIComponent(t)}`} class="post-tag">
                <iconify-icon icon="mdi:tag" aria-hidden="true"></iconify-icon>
                {t}
              </a>
            ))}
          </div>
        )}
      </header>
    )}

    {isEncrypted ? (
      <div class="post-encrypted" id="post-encrypted" data-pwd={post.data.password}>
        <div class="post-encrypted__icon"><iconify-icon icon="mdi:lock"></iconify-icon></div>
        <h3>这篇文章已加密</h3>
        <p>请输入访问密码以查看内容</p>
        <div class="post-encrypted__input-wrap">
          <input type="password" id="post-password" placeholder="请输入密码" />
          <button id="post-unlock-btn">解锁</button>
        </div>
        <p class="post-encrypted__hint" id="post-encrypted-hint"></p>
        <div class="post-encrypted__content prose-sakura is-hidden" id="post-encrypted-content">
          <Content />
        </div>
      </div>
    ) : (
      <div class="post-body">
        <aside class="post-toc" id="post-toc" aria-label="文章目录" hidden>
          <div class="post-toc__header">
            <span class="post-toc__title">
              <iconify-icon icon="mdi:format-list-bulleted" aria-hidden="true"></iconify-icon>
              目录
            </span>
            <div class="post-toc__actions">
              <button type="button" class="post-toc__settings" id="post-toc-settings-btn" aria-label="目录设置" aria-expanded="false">
                <iconify-icon icon="mdi:cog-outline" aria-hidden="true"></iconify-icon>
              </button>
              <button type="button" class="post-toc__toggle" id="post-toc-toggle" aria-label="折叠目录">
                <iconify-icon icon="mdi:chevron-up" aria-hidden="true"></iconify-icon>
              </button>
            </div>
          </div>

          <div class="post-toc__settings-panel" id="post-toc-settings-panel" hidden>
            <label class="post-toc__setting">
              <span class="post-toc__setting-text">展示目录</span>
              <span class="post-toc__switch">
                <input type="checkbox" id="toc-setting-show">
                <span class="post-toc__switch-track"></span>
              </span>
            </label>
            <label class="post-toc__setting">
              <span class="post-toc__setting-text">移动端不展示在顶部</span>
              <span class="post-toc__switch">
                <input type="checkbox" id="toc-setting-mobile">
                <span class="post-toc__switch-track"></span>
              </span>
            </label>
            <div class="post-toc__setting">
              <span class="post-toc__setting-text">展示层级</span>
              <div class="post-toc__levels" id="toc-setting-levels">
                <button type="button" data-level="1">1</button>
                <button type="button" data-level="2">2</button>
                <button type="button" data-level="3">3</button>
                <button type="button" data-level="4">4</button>
              </div>
            </div>
          </div>

          <nav class="post-toc__nav" id="post-toc-nav"></nav>
        </aside>

        <div class="post-content-area">
          <div class="prose-sakura">
            <Content />
          </div>

          <!-- 评论区: 传入 comment_id 作为 yuamli pageId, 实现每篇文章独立留言区 -->
          <Comment pageId={post.data.comment_id || `/posts/${post.id}/`} />
        </div>
      </div>
    )}

    <nav class="post-neighbors">
      {prev && (
        <a class="post-neighbors__item post-neighbors__prev" href={`/posts/${prev.id}/`}>
          <span class="post-neighbors__label"><iconify-icon icon="ri:arrow-left-line"></iconify-icon> 上一篇</span>
          <span class="post-neighbors__title">{prev.data.title}</span>
        </a>
      )}
      {next && (
        <a class="post-neighbors__item post-neighbors__next" href={`/posts/${next.id}/`}>
          <span class="post-neighbors__label">下一篇 <iconify-icon icon="ri:arrow-right-line"></iconify-icon></span>
          <span class="post-neighbors__title">{next.data.title}</span>
        </a>
      )}
    </nav>

    <div class="post-copyright">
      <p><strong>本文作者：</strong>{author}</p>
      <p><strong>本文链接：</strong><a href={new URL(`/posts/${post.id}/`, Astro.site).href}>{new URL(`/posts/${post.id}/`, Astro.site).href}</a></p>
      <p><strong>版权声明：</strong>本博客所有文章除特别声明外，均采用 {licenseName} 许可协议。转载请注明来自 <a href={Astro.site?.href}>Sumyu</a>。</p>
    </div>
  </article>
</Layout>

<script>
  const ALERT_CONFIG = {
    note: { icon: '📌', title: 'NOTE' },
    tip: { icon: '💡', title: 'TIP' },
    warning: { icon: '⚠️', title: 'WARNING' },
    important: { icon: '❗', title: 'IMPORTANT' },
    caution: { icon: '🔒', title: 'CAUTION' },
  };

  function processGithubAlerts() {
    const article = document.querySelector('.prose-sakura');
    if (!article) return;

    article.querySelectorAll('blockquote').forEach((blockquote) => {
      const firstP = blockquote.querySelector('p:first-child');
      if (!firstP) return;

      const text = firstP.textContent || '';
      const match = text.match(/^\[!(\w+)\]\s*/);
      if (!match) return;

      const alertType = match[1].toLowerCase();
      const config = ALERT_CONFIG[alertType as keyof typeof ALERT_CONFIG];
      if (!config) return;

      const alertDiv = document.createElement('div');
      alertDiv.className = 'github-alert';
      alertDiv.dataset.type = alertType;

      const header = document.createElement('div');
      header.className = 'github-alert__header';

      const icon = document.createElement('span');
      icon.className = 'github-alert__icon';
      icon.textContent = config.icon;

      const title = document.createElement('span');
      title.textContent = config.title;

      header.appendChild(icon);
      header.appendChild(title);

      const content = document.createElement('div');
      content.className = 'github-alert__content';

      const remainingText = text.slice(match[0].length).trim();
      if (remainingText) {
        firstP.textContent = remainingText;
      } else {
        firstP.remove();
      }

      while (blockquote.firstChild) {
        content.appendChild(blockquote.firstChild);
      }

      alertDiv.appendChild(header);
      alertDiv.appendChild(content);

      blockquote.parentNode?.replaceChild(alertDiv, blockquote);
    });
  }

  let postTocCleanup = null;

  // ---- 目录设置：localStorage 持久化 ----
  const TOC_SETTINGS_KEY = 'sumyu-toc-settings';
  const TOC_SETTINGS_DEFAULT = { show: true, mobileCollapse: false, maxLevel: 4 };

  function loadTocSettings() {
    try {
      const raw = localStorage.getItem(TOC_SETTINGS_KEY);
      if (!raw) return { ...TOC_SETTINGS_DEFAULT };
      const parsed = JSON.parse(raw);
      return {
        show: typeof parsed.show === 'boolean' ? parsed.show : TOC_SETTINGS_DEFAULT.show,
        mobileCollapse: typeof parsed.mobileCollapse === 'boolean' ? parsed.mobileCollapse : TOC_SETTINGS_DEFAULT.mobileCollapse,
        maxLevel: [1, 2, 3, 4].includes(parsed.maxLevel) ? parsed.maxLevel : TOC_SETTINGS_DEFAULT.maxLevel,
      };
    } catch {
      return { ...TOC_SETTINGS_DEFAULT };
    }
  }

  function saveTocSettings(settings) {
    try { localStorage.setItem(TOC_SETTINGS_KEY, JSON.stringify(settings)); } catch {}
  }

  function syncTocSettingsUI(settings) {
    const showInput = document.getElementById('toc-setting-show');
    const mobileInput = document.getElementById('toc-setting-mobile');
    const levelsBox = document.getElementById('toc-setting-levels');
    if (showInput) showInput.checked = settings.show;
    if (mobileInput) mobileInput.checked = settings.mobileCollapse;
    if (levelsBox) {
      levelsBox.querySelectorAll('button').forEach((b) => {
        b.classList.toggle('is-active', parseInt(b.dataset.level || '0', 10) === settings.maxLevel);
      });
    }
  }

  function updateToggleIcon() {
    const toc = document.getElementById('post-toc');
    const toggle = document.getElementById('post-toc-toggle');
    if (!toc || !toggle) return;
    const collapsed = toc.classList.contains('is-collapsed');
    toggle.setAttribute('aria-label', collapsed ? '展开目录' : '折叠目录');
    toggle.querySelector('iconify-icon')?.setAttribute('icon', collapsed ? 'mdi:chevron-down' : 'mdi:chevron-up');
  }

  // ---- 构建文章目录（标题 + 列表项，多级缩进，支持设置） ----
  function buildToc() {
    if (postTocCleanup) { postTocCleanup(); postTocCleanup = null; }

    const article = document.querySelector('.post-body .prose-sakura');
    const toc = document.getElementById('post-toc');
    const tocNav = document.getElementById('post-toc-nav');
    const toggle = document.getElementById('post-toc-toggle');
    if (!article || !toc || !tocNav) return;

    const settings = loadTocSettings();
    syncTocSettingsUI(settings);
    bindTocSettings();

    // 提取目录项：h2/h3/h4 标题 + 有序/无序列表项，按文档顺序
    // 深度 depth：1=## / 2=### / 3=有序列表 / 4=无序列表（嵌套逐级 +1），每小一级缩进 2 字符
    const liTitle = (li) => {
      let text = '';
      for (const child of li.childNodes) {
        if (child.nodeType === Node.TEXT_NODE) {
          text += child.textContent;
        } else if (child.nodeType === Node.ELEMENT_NODE && child.tagName !== 'UL' && child.tagName !== 'OL') {
          text += child.textContent;
        }
      }
      return text.replace(/\s+/g, ' ').trim();
    };

    const items = [];
    let headingDepth = 0;
    const walker = document.createTreeWalker(article, NodeFilter.SHOW_ELEMENT);
    let node;
    while ((node = walker.nextNode())) {
      const tag = node.tagName;
      if (tag === 'H2') {
        headingDepth = 1;
        items.push({ el: node, depth: 1, text: node.textContent.replace(/\s+/g, ' ').trim() });
      } else if (tag === 'H3') {
        headingDepth = 2;
        items.push({ el: node, depth: 2, text: node.textContent.replace(/\s+/g, ' ').trim() });
      } else if (tag === 'H4') {
        headingDepth = 3;
        items.push({ el: node, depth: 3, text: node.textContent.replace(/\s+/g, ' ').trim() });
      } else if (tag === 'LI') {
        let listDepth = 0;
        let p = node;
        while (p) {
          const pt = p.tagName;
          if (pt === 'UL' || pt === 'OL') listDepth++;
          p = p.parentElement;
        }
        const text = liTitle(node);
        if (!text) continue;
        items.push({ el: node, depth: headingDepth + listDepth, text });
      }
    }

    // 按"展示层级"过滤
    const visible = items.filter((it) => it.depth <= settings.maxLevel);

    // 展示目录开关：关闭时只保留标题栏（含设置入口），隐藏导航与折叠按钮
    const off = !settings.show;
    toc.classList.toggle('toc-off', off);
    toc.hidden = !off && visible.length < 2;

    tocNav.innerHTML = '';
    if (visible.length > 0) {
      const ul = document.createElement('ul');
      visible.forEach((item, i) => {
        const el = item.el;
        if (!el.id) el.id = `toc-${i}`;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${el.id}`;
        a.textContent = item.text.length > 48 ? item.text.slice(0, 48) + '…' : item.text;
        a.title = item.text;
        a.dataset.target = el.id;
        // 每小一级缩进两字符：目录字号 14px，1em ≈ 1 个中文字符宽度
        a.style.paddingLeft = `calc(10px + ${(item.depth - 1) * 2}em)`;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const target = document.getElementById(el.id);
          if (target) {
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            history.replaceState(null, '', `#${el.id}`);
          }
        });
        li.appendChild(a);
        ul.appendChild(li);
      });
      tocNav.appendChild(ul);
    }

    // 移动端不展示在顶部：开启后，移动端目录默认折叠收起
    const isMobile = window.matchMedia('(max-width: 1099px)').matches;
    toc.classList.toggle('is-collapsed', !!(settings.mobileCollapse && isMobile));
    updateToggleIcon();

    // 阅读进度高亮（只高亮当前章节，不做容器内自动滚动，避免抖动）
    let currentActive = null;
    const setActive = (id) => {
      if (currentActive === id) return;
      if (currentActive) {
        tocNav.querySelector(`a[data-target="${currentActive}"]`)?.classList.remove('is-active');
      }
      currentActive = id;
      tocNav.querySelector(`a[data-target="${id}"]`)?.classList.add('is-active');
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) setActive(en.target.id); });
    }, { rootMargin: '-60px 0px -70% 0px', threshold: 0 });
    visible.forEach((item) => io.observe(item.el));

    // 折叠 / 展开
    const onToggle = () => {
      toc.classList.toggle('is-collapsed');
      updateToggleIcon();
    };
    toggle?.addEventListener('click', onToggle);

    postTocCleanup = () => {
      io.disconnect();
      toggle?.removeEventListener('click', onToggle);
    };
  }

  // ---- 目录设置面板交互 ----
  // 把面板贴到设置按钮正下方（fixed 定位，由 JS 计算坐标）
  function positionTocSettingsPanel() {
    const panel = document.getElementById('post-toc-settings-panel');
    const btn = document.getElementById('post-toc-settings-btn');
    if (!panel || !btn || panel.hidden) return;

    const r = btn.getBoundingClientRect();
    const gap = 6;
    const margin = 8;
    const vw = document.documentElement.clientWidth;
    const vh = document.documentElement.clientHeight;
    const pw = panel.offsetWidth;
    const ph = panel.offsetHeight;

    // 右边缘与按钮右边缘对齐，向左展开（放不下时贴边）
    let left = r.right - pw;
    if (left < margin) left = margin;
    if (left + pw > vw - margin) left = vw - margin - pw;

    // 正下方；下方空间不足时翻到按钮上方
    let top = r.bottom + gap;
    if (top + ph > vh - margin) {
      const above = r.top - gap - ph;
      top = above >= margin ? above : Math.max(margin, vh - margin - ph);
    }

    panel.style.left = `${Math.round(left)}px`;
    panel.style.top = `${Math.round(top)}px`;
  }

  function closeTocSettings() {
    const panel = document.getElementById('post-toc-settings-panel');
    const btn = document.getElementById('post-toc-settings-btn');
    if (!panel || panel.hidden) return;
    panel.hidden = true;
    btn?.setAttribute('aria-expanded', 'false');
    // 归还到目录栏里，避免挂载在 body 上跨页残留
    if (panel.parentElement === document.body) {
      const toc = document.getElementById('post-toc');
      const nav = document.getElementById('post-toc-nav');
      if (toc) toc.insertBefore(panel, nav && nav.parentElement === toc ? nav : null);
    }
  }

  function openTocSettings() {
    const panel = document.getElementById('post-toc-settings-panel');
    const btn = document.getElementById('post-toc-settings-btn');
    if (!panel) return;
    // 目录栏（sticky）自成层叠上下文，面板留在里面会被看板娘等浮层压住；
    // 打开时挂到 body 上，保证面板永远浮在最上层
    if (panel.parentElement !== document.body) {
      document.body.appendChild(panel);
    }
    panel.hidden = false;
    positionTocSettingsPanel();
    btn?.setAttribute('aria-expanded', 'true');
  }

  // 点击任意位置关闭（capture 阶段，避免被内部元素的 stopPropagation 拦掉）
  function setupTocSettings() {
    document.addEventListener(
      'pointerdown',
      (e) => {
        const panel = document.getElementById('post-toc-settings-panel');
        const btn = document.getElementById('post-toc-settings-btn');
        if (!panel || panel.hidden) return;
        const t = e.target;
        if (!(t instanceof Node)) return;
        if (btn?.contains(t) || panel.contains(t)) return;
        closeTocSettings();
      },
      true
    );

    // 页面滚动/窗口尺寸变化时跟随按钮重新定位
    const reposition = () => {
      const panel = document.getElementById('post-toc-settings-panel');
      if (panel && !panel.hidden) positionTocSettingsPanel();
    };
    window.addEventListener('scroll', reposition, true);
    window.addEventListener('resize', reposition);

    // Esc 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeTocSettings();
    });
  }

  // 直接绑定设置项（用 on* 赋值，每次 buildToc 覆盖，避免重复监听）
  function bindTocSettings() {
    const settingsBtn = document.getElementById('post-toc-settings-btn');
    const panel = document.getElementById('post-toc-settings-panel');
    const showInput = document.getElementById('toc-setting-show');
    const mobileInput = document.getElementById('toc-setting-mobile');
    const levelsBox = document.getElementById('toc-setting-levels');

    if (settingsBtn && panel) {
      settingsBtn.onclick = (e) => {
        e.stopPropagation();
        if (panel.hidden) openTocSettings();
        else closeTocSettings();
      };
    }
    if (showInput) {
      showInput.onchange = () => {
        const s = loadTocSettings();
        s.show = showInput.checked;
        saveTocSettings(s);
        buildToc();
      };
    }
    if (mobileInput) {
      mobileInput.onchange = () => {
        const s = loadTocSettings();
        s.mobileCollapse = mobileInput.checked;
        saveTocSettings(s);
        buildToc();
      };
    }
    if (levelsBox) {
      levelsBox.onclick = (e) => {
        const t = e.target;
        if (!(t instanceof Element)) return;
        const b = t.closest('button');
        if (!b) return;
        const lv = parseInt(b.dataset.level || '4', 10);
        const s = loadTocSettings();
        s.maxLevel = lv;
        saveTocSettings(s);
        buildToc();
      };
    }
  }

  function initPostDetail() {
    // ---- 处理 GitHub Alerts ----
    processGithubAlerts();

    // ---- 构建目录 ----
    buildToc();

    // ---- 表格横向滚动 ----
    document.querySelectorAll('.prose-sakura table').forEach((table) => {
      if (table.parentElement?.classList.contains('prose-table-wrap')) return;
      const wrap = document.createElement('div');
      wrap.className = 'prose-table-wrap';
      table.parentNode?.insertBefore(wrap, table);
      wrap.appendChild(table);
    });

    // ---- 加密文章解锁 ----
    const encryptedBlock = document.getElementById('post-encrypted');
    if (encryptedBlock) {
      const unlockBtn = document.getElementById('post-unlock-btn');
      const pwdInput = document.getElementById('post-password') as HTMLInputElement | null;
      const hint = document.getElementById('post-encrypted-hint');
      const content = document.getElementById('post-encrypted-content');
      const expectedPwd = encryptedBlock.getAttribute('data-pwd') || '';
      function tryUnlock() {
        if (!pwdInput || !hint || !content || !encryptedBlock) return;
        const entered = pwdInput.value;
        if (entered === expectedPwd) {
          content.classList.remove('is-hidden');
          hint.textContent = '解锁成功';
          hint.style.color = 'var(--sakura-primary)';
          encryptedBlock.querySelector('.post-encrypted__icon')?.classList.add('is-unlocked');
        } else {
          hint.textContent = '密码错误，请重试';
          hint.style.color = '#e74c3c';
        }
      }
      unlockBtn?.addEventListener('click', tryUnlock);
      pwdInput?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') tryUnlock();
      });
    }
  }
  initPostDetail();
  setupTocSettings();
  document.addEventListener('astro:page-load', initPostDetail);
</script>

