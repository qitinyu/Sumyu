---
import Layout from '@layouts/Layout.astro';
---

<Layout title="404 未找到" description="页面不存在">
  <div class="not-found container">
    <div class="not-found__inner">
      <div class="not-found__code">404</div>
      <p class="not-found__msg">樱花飘落，找不到这一页 🌸</p>
      <a class="not-found__back" href="/">返回首页</a>
    </div>
  </div>
</Layout>

<style>
  .not-found {
    min-height: 70vh; display: flex; align-items: center; justify-content: center;
    text-align: center;
  }
  .not-found__code {
    font-size: 120px; font-weight: 700; color: var(--sakura-primary);
    font-family: var(--font-heading); line-height: 1;
    text-shadow: 0 8px 24px rgba(223,145,147,0.3);
    animation: loop-float 3s ease-in-out infinite;
  }
  .not-found__msg { font-size: 16px; color: var(--text-muted); margin: 16px 0 28px; }
  .not-found__back {
    display: inline-block; padding: 10px 28px;
    border: 1px solid var(--sakura-primary); color: var(--sakura-primary);
    border-radius: var(--radius-full); transition: all var(--transition-fast);
  }
  .not-found__back:hover { background: var(--sakura-primary); color: #fff; }
</style>
