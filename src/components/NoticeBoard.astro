---
import { ANNOUNCEMENTS, SITE_START_DATE, TOTAL_WORD_COUNT } from '@/config';
import { formatDate } from '@/utils/posts';
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  randomPosts?: any[];
}

const { randomPosts = [] } = Astro.props;

// 读取 /public/hero/suiji 目录下的图片
const heroDir = path.join(process.cwd(), 'public', 'hero', 'suiji');
let heroImages: string[] = [];
try {
  heroImages = fs.readdirSync(heroDir)
    .filter(f => /\.(webp|jpg|jpeg|png|gif)$/i.test(f))
    .map(f => `/hero/suiji/${f}`);
} catch (e) {
  heroImages = [];
}

// 用于轮播的随机图片（打乱顺序）
const shuffledImages = [...heroImages].sort(() => Math.random() - 0.5);

// 用于滚筒的随机文章数据（打乱后最多取 20 篇）
const rollerPosts = [...randomPosts].sort(() => Math.random() - 0.5).slice(0, 20);
const totalArticles = randomPosts.length;
const latestPost = randomPosts[0] ?? null;
const lastEditDate = latestPost
  ? (latestPost.data.updatedDate || latestPost.data.pubDate)
  : null;
---

<section class="notice-board-wrap">
  <!-- 上方三列: 公告(左) + 随机图片(中) + 随机文章(右) -->
  <div class="notice-board__row-top">
    <!-- 站点公告 -->
    <div class="notice-board__section notice-board__section--announce">
      <h3 class="notice-board__heading">
        <iconify-icon icon="ri:megaphone-line" aria-hidden="true"></iconify-icon>
        站点公告
      </h3>
      <ul class="notice-board__list">
        {ANNOUNCEMENTS.map((text) => (
          <li class="notice-board__item">
            <span class="notice-board__dot"></span>
            {text}
          </li>
        ))}
      </ul>
    </div>

    <!-- 随机图片轮播 -->
    <div class="notice-board__section notice-board__section--images">
      <h3 class="notice-board__heading">
        <iconify-icon icon="ri:image-line" aria-hidden="true"></iconify-icon>
        随机图片
      </h3>
      <div class="image-carousel" id="image-carousel"
        data-images={JSON.stringify(shuffledImages)}>
        <div class="image-carousel__frame">
          {shuffledImages.length > 0 && (
            <img src={shuffledImages[0]} alt="随机图片" loading="eager" fetchpriority="high" decoding="async" id="carousel-img" />
          )}
        </div>
        <div class="image-carousel__dots" role="tablist" aria-label="图片切换">
          {shuffledImages.map((_, i) => (
            <button type="button" class={`image-carousel__dot${i === 0 ? ' is-active' : ''}`} data-idx={i} role="tab" aria-label={`切换到第 ${i + 1} 张图片`}></button>
          ))}
        </div>
      </div>
    </div>

    <!-- 滚筒式随机文章 -->
    <div class="notice-board__section notice-board__section--articles">
      <h3 class="notice-board__heading">
        <iconify-icon icon="ri:article-line" aria-hidden="true"></iconify-icon>
        随机文章
      </h3>
      <div class="roller" id="roller">
        <div class="roller__track" id="roller-track">
          {rollerPosts.map((post, i) => (
            <a class={`roller__card${i === 0 ? ' is-active' : ''}`} href={`/posts/${post.id}/`} data-idx={i}>
              <span class="roller__title">{post.data.title}</span>
              <span class="roller__meta">{formatDate(post.data.pubDate)} · {post.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- 下方横向站点统计 4*1 布局 -->
  <div class="notice-board__row-bottom">
    <div class="site-stats site-stats--horizontal">
      <div class="site-stats__item">
        <iconify-icon icon="ri:time-line" aria-hidden="true"></iconify-icon>
        <div class="site-stats__info">
          <span class="site-stats__value" id="stat-runtime">0 天</span>
          <span class="site-stats__label">运行时长</span>
        </div>
      </div>
      <div class="site-stats__item">
        <iconify-icon icon="ri:file-text-line" aria-hidden="true"></iconify-icon>
        <div class="site-stats__info">
          <span class="site-stats__value">{totalArticles}</span>
          <span class="site-stats__label">文章总数</span>
        </div>
      </div>
      <div class="site-stats__item">
        <iconify-icon icon="ri:quill-pen-line" aria-hidden="true"></iconify-icon>
        <div class="site-stats__info">
          <span class="site-stats__value">{TOTAL_WORD_COUNT}</span>
          <span class="site-stats__label">总字数</span>
        </div>
      </div>
      <div class="site-stats__item">
        <iconify-icon icon="ri:edit-line" aria-hidden="true"></iconify-icon>
        <div class="site-stats__info">
          <span class="site-stats__value">{lastEditDate ? formatDate(lastEditDate) : '暂无'}</span>
          <span class="site-stats__label">最后编辑</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let imageTimer = null;
  let rollerTimer = null;
  let runtimeTimer = null;

  function initNoticeBoard() {
    // ---- 随机图片轮播 ----
    const carousel = document.getElementById('image-carousel');
    if (carousel) {
      const images = JSON.parse(carousel.dataset.images || '[]');
      const img = document.getElementById('carousel-img');
      const dots = carousel.querySelectorAll('.image-carousel__dot');
      let idx = 0;

      function renderImage(i) {
        if (!images[i]) return;
        idx = i;
        if (img) {
          img.style.opacity = '0';
          setTimeout(() => {
            img.src = images[i];
            img.style.opacity = '1';
          }, 200);
        }
        dots.forEach((d, di) => d.classList.toggle('is-active', di === i));
      }

      dots.forEach((d, di) => d.addEventListener('click', () => {
        renderImage(di);
        resetImageTimer();
      }));

      function resetImageTimer() {
        if (imageTimer) clearInterval(imageTimer);
        if (images.length > 1) {
          imageTimer = setInterval(() => renderImage((idx + 1) % images.length), 5000);
        }
      }
      resetImageTimer();
    }

    // ---- 滚筒式随机文章 ----
    const track = document.getElementById('roller-track');
    if (track) {
      const cards = track.querySelectorAll('.roller__card');
      if (cards.length > 0) {
        let activeIdx = 0;
        const itemHeight = 72;
        const gap = 10;

        function setActive(i) {
          activeIdx = i;
          const offset = -(activeIdx * (itemHeight + gap));
          track.style.transform = `translateY(${offset}px)`;
          cards.forEach((c, ci) => {
            c.classList.toggle('is-active', ci === activeIdx);
          });
        }

        function resetRollerTimer() {
          if (rollerTimer) clearInterval(rollerTimer);
          rollerTimer = setInterval(() => {
            activeIdx = (activeIdx + 1) % cards.length;
            setActive(activeIdx);
          }, 4000);
        }

        setActive(0);
        resetRollerTimer();
      }
    }

    // ---- 运行时长计算 ----
    const runtimeEl = document.getElementById('stat-runtime');
    if (runtimeEl) {
      if (runtimeTimer) clearInterval(runtimeTimer);
      const startDate = new Date('2026-07-01T00:00:00');
      function updateRuntime() {
        const now = new Date();
        const diff = now.getTime() - startDate.getTime();
        if (diff < 0) { runtimeEl.textContent = '0 天'; return; }
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        if (days > 0) {
          runtimeEl.textContent = `${days} 天 ${hours} 时`;
        } else {
          runtimeEl.textContent = `${hours} 时`;
        }
      }
      updateRuntime();
      runtimeTimer = setInterval(updateRuntime, 60000);
    }
  }

  initNoticeBoard();
  document.addEventListener('astro:page-load', initNoticeBoard);
</script>

<style>
  .notice-board-wrap {
    display: flex; flex-direction: column; gap: 20px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow-sm);
  }

  /* 上方三列: 公告(左) + 图片(中) + 文章(右) */
  .notice-board__row-top {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  /* 下方站点统计横向排列 */
  .notice-board__row-bottom {
    margin-top: 20px;
  }

  /* 通用题头 */
  .notice-board__heading {
    font-size: 15px; color: var(--sakura-primary); font-weight: 600;
    display: inline-flex; align-items: center; gap: 6px;
    margin-bottom: 14px;
  }
  .notice-board__heading iconify-icon { font-size: 18px; }

  /* ---- 站点公告列表 ---- */
  .notice-board__list { display: flex; flex-direction: column; gap: 8px; }
  .notice-board__item {
    display: flex; align-items: flex-start; gap: 8px;
    font-size: 13px; color: var(--text-base); line-height: 1.7;
  }
  .notice-board__dot {
    flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%;
    background: var(--sakura-primary); margin-top: 7px;
  }

  /* ---- 随机图片轮播 ---- */
  .image-carousel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .image-carousel__frame {
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 3px solid #fff;
    transition: transform var(--transition-base);
  }
  html.dark .image-carousel__frame { border-color: var(--bg-soft); }
  .image-carousel__frame:hover { transform: scale(1.02); }
  .image-carousel__frame img {
    width: 100%; height: 100%; object-fit: cover;
    transition: opacity 0.3s;
  }

  .image-carousel__dots {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
  }
  .image-carousel__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--border-color);
    transition: all var(--transition-fast);
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .image-carousel__dot.is-active {
    background: var(--sakura-primary);
    transform: scale(1.3);
  }

  /* ---- 滚筒式随机文章 ---- */
  .roller {
    height: calc(3 * 72px + 2 * 10px);
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-md);
  }
  .roller__track {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: calc(72px + 10px);
    padding-bottom: calc(72px + 10px);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .roller__card {
    height: 72px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 14px;
    background: var(--bg-soft);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    text-decoration: none;
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    transform: scale(0.92);
    opacity: 0.7;
    overflow: hidden;
  }
  .roller__card.is-active {
    transform: scale(1);
    opacity: 1;
    background: var(--sakura-primary-bg);
    border-color: var(--sakura-primary-soft);
  }
  .roller__card:hover {
    border-color: var(--sakura-primary);
  }
  .roller__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .roller__meta {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- 站点统计 ---- */
  .site-stats {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
  }
  /* 横向 4*1 布局 */
  .site-stats--horizontal {
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .site-stats--compact {
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .site-stats__item {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px;
    background: var(--bg-soft);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-soft);
    transition: all var(--transition-fast);
  }
  .site-stats__item:hover { border-color: var(--sakura-primary-soft); transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .site-stats__item iconify-icon { font-size: 22px; color: var(--sakura-primary); flex-shrink: 0; }
  .site-stats__info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .site-stats__value { font-size: 16px; font-weight: 600; color: var(--text-strong); }
  .site-stats__label { font-size: 11px; color: var(--text-muted); }

  @media (max-width: 768px) {
    .notice-board-wrap { padding: 18px; gap: 20px; }
    .notice-board__row-top { grid-template-columns: 1fr; gap: 20px; }
    .notice-board__row-bottom { margin-top: 16px; }
    .image-carousel__frame { aspect-ratio: 16 / 9; }
    .site-stats--horizontal { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .site-stats__item { padding: 12px; gap: 8px; }
    .site-stats__value { font-size: 14px; }
  }
</style>
