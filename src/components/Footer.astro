---
import { footerConfig } from '@/data/footer';

const { brand, copyright, powered, icp, customLines } = footerConfig;
---

<footer class="sakura-footer">
  <div class="sakura-footer__inner container">
    <!-- 第一行: 站点名 · 副标题 · 版本号 -->
    <div class="sakura-footer__brand">
      <span class="sakura-footer__title">{brand.title}</span>
      <span class="sakura-footer__sep">•</span>
      <span class="sakura-footer__subtitle">{brand.subtitle}</span>
      <span class="sakura-footer__sep">•</span>
      <span class="sakura-footer__version">V{powered.version}</span>
    </div>

    <!-- 第二行: 技术栈与作者 -->
    <div class="sakura-footer__row">
      Powered by
      <span class="sakura-footer__sep">•</span>
      {powered.framework} &amp; {powered.theme}
      <span class="sakura-footer__sep">•</span>
      {copyright.owner}
    </div>

    <!-- 第三行: 备案信息 (可选) -->
    {icp && (
      <div class="sakura-footer__row sakura-footer__icp" set:html={icp} />
    )}

    <!-- 自定义额外行 (可选) -->
    {customLines.map((line) => (
      <div class="sakura-footer__row" set:html={line} />
    ))}
  </div>
</footer>

<style>
  .sakura-footer {
    margin-top: 60px;
    background: var(--bg-card);
    border-top: 1px solid var(--border-color);
    padding: 10px 0 10px;
  }
  .sakura-footer__inner {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    text-align: center;
  }
  .sakura-footer__brand {
    display: inline-flex; align-items: center; gap: 8px;
    margin-bottom: 0;
  }
  .sakura-footer__title {
    font-size: 14px; font-weight: 600; color: var(--text-strong);
    letter-spacing: 0.05em;
  }
  .sakura-footer__subtitle {
    font-size: 12px; color: var(--sakura-primary); letter-spacing: 0.1em;
  }
  .sakura-footer__version {
    font-size: 11px; color: var(--text-muted); letter-spacing: 0.06em;
  }
  .sakura-footer__row {
    color: var(--text-muted); font-size: 12px; line-height: 1.5;
  }
  .sakura-footer__row a { color: var(--text-muted); transition: color var(--transition-fast); }
  .sakura-footer__row a:hover { color: var(--sakura-primary); }
  /* customLines 是 set:html 注入的, 拿不到样式作用域, 需要 :global */
  .sakura-footer__row :global(a) { color: var(--text-muted); }
  .sakura-footer__row :global(a:hover) { color: var(--sakura-primary); }
  .sakura-footer__sep { margin: 0 4px; color: var(--text-faint); opacity: 0.7; }
  .sakura-footer__icp { margin-top: 2px; }
</style>
