---
import { MUSIC } from '@/config';

// 数据岛只下发客户端需要的字段; WebDAV 凭据由服务端代理注入 (dev 中间件 / Pages Function), 不暴露到页面源码
const MUSIC_ISLAND = MUSIC.webdav
  ? { ...MUSIC, webdav: { ...MUSIC.webdav, username: '', password: '' } }
  : MUSIC;
---

<script is:inline type="application/json" id="music-config" set:html={JSON.stringify(MUSIC_ISLAND)} />

{MUSIC.enabled && (
  <div id="music-panel" class="music-panel" aria-hidden="true">
    <div class="music-panel__popup" id="music-popup">
      <div class="music-panel__header">
        <div class="music-panel__title">
          <iconify-icon icon="ri:music-2-line" aria-hidden="true"></iconify-icon>
          <span>音乐</span>
        </div>
        <button type="button" class="music-panel__close" id="music-close" aria-label="关闭">
          <iconify-icon icon="ri:close-line"></iconify-icon>
        </button>
      </div>

      <div class="music-panel__song">
        <div class="music-panel__cover" id="music-cover">
          <img src="" alt="封面" id="music-cover-img" loading="lazy" referrerpolicy="no-referrer" />
          <div class="music-panel__cover-placeholder">
            <iconify-icon icon="ri:music-2-fill"></iconify-icon>
          </div>
        </div>
        <div class="music-panel__song-info" id="music-song-info" title="点击查看歌词">
          <div class="music-panel__song-name" id="music-name">未播放</div>
          <div class="music-panel__song-artist" id="music-artist">--</div>
        </div>
      </div>
      <div class="music-panel__status" id="music-status" style="display:none;">
        <span class="music-panel__status-text" id="music-status-text"></span>
      </div>
      <div class="music-panel__progress">
        <span class="music-panel__time" id="music-time-cur">0:00</span>
        <div class="music-panel__progress-bar" id="music-progress">
          <div class="music-panel__progress-loaded" id="music-loaded"></div>
          <div class="music-panel__progress-played" id="music-played"></div>
          <div class="music-panel__progress-thumb" id="music-thumb"></div>
        </div>
        <span class="music-panel__time" id="music-time-dur">0:00</span>
      </div>

      <div class="music-panel__controls">
        <button type="button" class="music-ctrl-btn music-ctrl-btn--mode" id="music-mode" aria-label="播放模式" title="顺序播放">
          <iconify-icon icon="ri:order-play-line" id="music-mode-icon"></iconify-icon>
        </button>
        <button type="button" class="music-ctrl-btn music-ctrl-btn--side" id="music-prev" aria-label="上一首" title="上一首">
          <iconify-icon icon="ri:skip-back-fill"></iconify-icon>
        </button>
        <button type="button" class="music-ctrl-btn music-ctrl-btn--play" id="music-play" aria-label="播放/暂停">
          <iconify-icon icon="ri:play-fill" id="music-play-icon"></iconify-icon>
        </button>
        <button type="button" class="music-ctrl-btn music-ctrl-btn--side" id="music-next" aria-label="下一首" title="下一首">
          <iconify-icon icon="ri:skip-forward-fill"></iconify-icon>
        </button>
        <button type="button" class="music-ctrl-btn music-ctrl-btn--list" id="music-list-btn" aria-label="播放列表" title="播放列表">
          <iconify-icon icon="ri:play-list-2-line"></iconify-icon>
        </button>
      </div>

      <div class="music-panel__playlist" id="music-playlist" hidden>
        <div class="music-panel__playlist-head">
          <span>播放列表 · <span id="music-list-count">0</span> 首</span>
          <button type="button" class="music-panel__playlist-clear" id="music-list-clear" aria-label="收起列表">
            <iconify-icon icon="ri:arrow-up-s-line"></iconify-icon>
          </button>
        </div>
        <ul class="music-panel__playlist-body" id="music-list"></ul>
      </div>

      <div class="music-panel__lyrics" id="music-lyrics" hidden>
        <div class="music-panel__lyrics-body" id="music-lyrics-body"></div>
      </div>
    </div>
  </div>
)}

{MUSIC.enabled && (
  <audio id="music-audio" preload="auto" transition:persist="music-player-audio"></audio>
)}

<script>
  // ---- 音乐播放器 (View Transitions 适配) ----
  // 核心: audio 元素通过 transition:persist 跨页面存活, 音乐不中断
  // UI 元素每次过渡后重建, 通过 astro:page-load 重新绑定

  // 音源配置: 从 data island (#music-config) 读取, 对应 src/data/feature.config.json 的 music 段
  type MusicWebdavCfg = { url?: string; directory?: string; publicUrl?: string };
  type MusicCfg = { source?: string; api?: string; server?: string; type?: string; id?: string; webdav?: MusicWebdavCfg };
  const MUSIC_CFG: MusicCfg = (() => {
    try {
      const el = document.getElementById('music-config');
      return JSON.parse((el && el.textContent) || '{}');
    } catch (_) {
      return {};
    }
  })();

  const STATE_KEY = 'sumyu-music-state-v2';
  // v3: 新增歌词字段 (lrc), 旧缓存没有歌词需强制刷新
  const SESSION_SONGS_KEY = 'sumyu-music-songs-cache-v3';

  type Song = { name: string; artist: string; url: string; pic: string; lrc?: string };
  type PlayMode = 'order' | 'loop' | 'random';
  type SavedState = { currentIndex: number; currentTime: number; isPlaying: boolean; playMode: PlayMode };

  // ===== 模块级状态 (跨页面持久化) =====
  // 检查 localStorage 音乐开关, 若关闭则隐藏整个面板
  function checkMusicEnabled() {
    const val = localStorage.getItem('sumyu-music');
    return val === null ? false : val === 'true';
  }
  let songs: Song[] = [];
  let currentIndex = 0;
  let playMode: PlayMode = 'order';
  let isPlaying = false;
  let musicPanelIsOpen = false;
  let pendingSeek: number | null = null;
  let restoredFromCache = false;
  let lastToggleTime = 0;
  const TOGGLE_GUARD_MS = 350;
  let audioEventsBound = false;

  // ===== DOM 引用 (每次页面加载时更新) =====
  let $panel: HTMLElement | null = null;
  let $popup: HTMLElement | null = null;
  let $audio: HTMLAudioElement | null = null;
  let $musicOpen: HTMLElement | null = null;
  let $coverImg: HTMLImageElement | null = null;
  let $coverWrap: HTMLElement | null = null;
  let $nameEl: HTMLElement | null = null;
  let $artistEl: HTMLElement | null = null;
  let $timeCurEl: HTMLElement | null = null;
  let $timeDurEl: HTMLElement | null = null;
  let $progressBar: HTMLElement | null = null;
  let $playedBar: HTMLElement | null = null;
  let $loadedBar: HTMLElement | null = null;
  let $thumbEl: HTMLElement | null = null;
  let $modeBtn: HTMLElement | null = null;
  let $modeIcon: HTMLElement | null = null;
  let $prevBtn: HTMLElement | null = null;
  let $nextBtn: HTMLElement | null = null;
  let $playBtn: HTMLElement | null = null;
  let $playIcon: HTMLElement | null = null;
  let $listBtn: HTMLElement | null = null;
  let $listClearBtn: HTMLElement | null = null;
  let $playlistWrap: HTMLElement | null = null;
  let $listBody: HTMLElement | null = null;
  let $listCount: HTMLElement | null = null;
  let $lyricsWrap: HTMLElement | null = null;
  let $lyricsBody: HTMLElement | null = null;

  const modeConfig: Record<PlayMode, { icon: string; title: string }> = {
    order: { icon: 'ri:order-play-line', title: '顺序播放' },
    loop: { icon: 'ri:repeat-one-line', title: '单曲循环' },
    random: { icon: 'ri:shuffle-line', title: '随机播放' },
  };

  // ===== 纯函数 =====
  function formatTime(sec: number) {
    if (!isFinite(sec) || sec < 0) sec = 0;
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  }

  function saveState() {
    if (songs.length === 0) return;
    const state: SavedState = {
      currentIndex,
      currentTime: $audio?.currentTime || 0,
      isPlaying,
      playMode,
    };
    try { localStorage.setItem(STATE_KEY, JSON.stringify(state)); } catch (_) {}
    cacheSongs();
  }

  function cacheSongs() {
    if (songs.length === 0) return;
    try { sessionStorage.setItem(SESSION_SONGS_KEY, JSON.stringify(songs)); } catch (_) {}
  }

  function restoreState(): SavedState | null {
    try {
      const raw = localStorage.getItem(STATE_KEY);
      if (!raw) return null;
      return JSON.parse(raw) as SavedState;
    } catch (_) { return null; }
  }

  function restoreFromCache(): boolean {
    try {
      const raw = sessionStorage.getItem(SESSION_SONGS_KEY);
      if (!raw) return false;
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed) || parsed.length === 0) return false;
      songs = parsed;
      restoredFromCache = true;
      const saved = restoreState();
      if (saved) {
        currentIndex = Math.min(saved.currentIndex, songs.length - 1);
        isPlaying = saved.isPlaying;
        setMode(saved.playMode);
        pendingSeek = saved.currentTime;
      }
      const s = songs[currentIndex];
      if (s && $audio) {
        updateSongInfo();
        setAudioSource(s);
      }
      renderList();
      updatePlayBtn();
      return true;
    } catch (_) { return false; }
  }

  function setMode(m: PlayMode) {
    playMode = m;
    const cfg = modeConfig[m];
    $modeIcon?.setAttribute('icon', cfg.icon);
    $modeBtn?.setAttribute('title', cfg.title);
    $modeBtn?.classList.toggle('is-active', m !== 'order');
  }

  // ===== UI 更新 =====
  function updateSongInfo() {
    const s = songs[currentIndex];
    if (!s) return;
    if ($nameEl) $nameEl.textContent = s.name || '未知歌名';
    if ($artistEl) $artistEl.textContent = s.artist || '--';
    if ($coverImg && $coverWrap) {
      if (s.pic) {
        $coverImg.src = s.pic;
        $coverImg.style.display = '';
        $coverWrap.querySelector('.music-panel__cover-placeholder')?.setAttribute('style', 'display:none');
        // 封面加载失败 → 显示 placeholder (网易云防盗链可能导致 403)
        $coverImg.onerror = () => {
          $coverImg!.style.display = 'none';
          $coverWrap!.querySelector('.music-panel__cover-placeholder')?.removeAttribute('style');
        };
        $coverImg.onload = () => {
          $coverImg!.style.display = '';
        };
      } else {
        $coverImg.style.display = 'none';
        $coverWrap.querySelector('.music-panel__cover-placeholder')?.removeAttribute('style');
      }
    }
  }

  function updatePlayBtn() {
    if (!$playIcon) return;
    $playIcon.setAttribute('icon', isPlaying ? 'ri:pause-fill' : 'ri:play-fill');
    if (isPlaying) {
      $musicOpen?.classList.add('is-playing');
      $coverWrap?.classList.add('is-spinning');
    } else {
      $musicOpen?.classList.remove('is-playing');
      $coverWrap?.classList.remove('is-spinning');
    }
  }

  function renderList() {
    if (!$listBody || !$listCount) return;
    $listCount.textContent = String(songs.length);
    $listBody.innerHTML = songs.map((s, i) => `
      <li class="music-list-item${i === currentIndex ? ' is-active' : ''}" data-idx="${i}">
        <span class="music-list-item__idx">${i === currentIndex && isPlaying ? '<iconify-icon icon="ri:volume-up-fill"></iconify-icon>' : String(i + 1).padStart(2, '0')}</span>
        <span class="music-list-item__info">
          <span class="music-list-item__name">${s.name}</span>
          <span class="music-list-item__artist">${s.artist}</span>
        </span>
      </li>
    `).join('');
  }

  // ===== 歌词 (LRC) =====
  type LyricLine = { t: number; text: string };
  let lyricLines: LyricLine[] = [];
  let lyricCurrent = -1;
  let lyricsOpen = false;
  let lyricToken = 0;
  const lyricCache = new Map<string, LyricLine[]>();

  // 解析 LRC: 支持 [mm:ss.xx] 与一行多时间标签; 元数据行 ([ar:]/[ti:] 等) 不匹配时间格式自动跳过
  function parseLrc(text: string): LyricLine[] {
    const lines: LyricLine[] = [];
    for (const raw of text.split(/\r?\n/)) {
      const tags = [...raw.matchAll(/\[(\d{1,3}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g)];
      if (tags.length === 0) continue;
      const content = raw.replace(/\[[^\]]*\]/g, '').trim();
      for (const m of tags) {
        const frac = m[3] || '0';
        lines.push({
          t: parseInt(m[1], 10) * 60 + parseInt(m[2], 10) + parseInt(frac, 10) / Math.pow(10, frac.length),
          text: content,
        });
      }
    }
    lines.sort((a, b) => a.t - b.t);
    return lines;
  }

  function renderLyrics() {
    if (!$lyricsBody) return;
    if (lyricLines.length === 0) {
      $lyricsBody.innerHTML = '<p class="music-lyrics-empty">暂无歌词 ♪</p>';
      return;
    }
    $lyricsBody.innerHTML = lyricLines
      .map((l, i) => `<p class="music-lyrics-line${i === lyricCurrent ? ' is-active' : ''}" data-idx="${i}">${l.text ? l.text.replace(/</g, '&lt;') : '♪'}</p>`)
      .join('');
  }

  async function loadLyrics(s: Song | undefined) {
    const token = ++lyricToken;
    lyricLines = [];
    lyricCurrent = -1;
    renderLyrics();
    if (!s || !s.lrc) return;
    const cached = lyricCache.get(s.lrc);
    if (cached) {
      lyricLines = cached;
      renderLyrics();
      return;
    }
    try {
      const res = await fetch(s.lrc);
      if (!res.ok) return;
      let text = await res.text();
      // 网易云歌词接口返回 JSON (内嵌 LRC 文本), 其余当作纯 LRC 文件
      if (text.trimStart().startsWith('{')) {
        try {
          const j = JSON.parse(text);
          text = (j && j.lrc && j.lrc.lyric) || (j && j.klyric && j.klyric.lyric) || '';
        } catch (_) { text = ''; }
      }
      const parsed = parseLrc(text);
      lyricCache.set(s.lrc, parsed);
      if (token !== lyricToken) return; // 期间已切歌
      lyricLines = parsed;
      renderLyrics();
    } catch (_) {}
  }

  // 按当前播放进度高亮歌词行并居中滚动
  function updateLyric(cur: number) {
    if (lyricLines.length === 0 || !$lyricsBody) return;
    let idx = -1;
    for (let i = 0; i < lyricLines.length; i++) {
      if (lyricLines[i].t <= cur + 0.2) idx = i;
      else break;
    }
    if (idx === lyricCurrent) return;
    lyricCurrent = idx;
    const children = $lyricsBody.children;
    for (let i = 0; i < children.length; i++) {
      children[i].classList.toggle('is-active', i === idx);
    }
    const el = children[idx] as HTMLElement | undefined;
    if (el) $lyricsBody.scrollTo({ top: el.offsetTop - $lyricsBody.clientHeight / 2 + el.clientHeight / 2, behavior: 'smooth' });
  }

  // ===== 核心播放逻辑 =====
  function loadSong(idx: number, autoPlay: boolean) {
    currentIndex = idx;
    const s = songs[idx];
    if (!s || !$audio) return;
    updateSongInfo();
    if (autoPlay || isPlaying) {
      isPlaying = true;
    }
    // 设置音频源; loadedmetadata 后 isPlaying 会自动续播
    setAudioSource(s);
    renderList();
    updatePlayBtn();
    saveState();
  }

  function playNext() {
    if (songs.length === 0) return;
    if (playMode === 'loop') {
      if ($audio) { $audio.currentTime = 0; $audio.play().catch(() => {}); }
      return;
    }
    let next: number;
    if (playMode === 'random') {
      next = Math.floor(Math.random() * songs.length);
    } else {
      next = (currentIndex + 1) % songs.length;
    }
    loadSong(next, true);
  }

  function playPrev() {
    if (songs.length === 0) return;
    let prev: number;
    if (playMode === 'random') {
      prev = Math.floor(Math.random() * songs.length);
    } else {
      prev = (currentIndex - 1 + songs.length) % songs.length;
    }
    loadSong(prev, true);
  }

  // ===== 音频源设置 =====
  // WebDAV 走同源代理 (服务端注入鉴权并剥离 attachment 响应头), 直接流式播放, 原生支持 Range 与进度拖动
  function setAudioSource(s: Song) {
    if (!$audio) return;
    $audio.src = s.url;
    // 切歌时同步加载歌词 (WebDAV 走代理, meting 为外链, 失败则显示"暂无歌词")
    loadLyrics(s);
  }

  // ===== 加载歌单 (按 source 分发: meting / webdav) =====
  async function loadSongs() {
    if (MUSIC_CFG.source === 'webdav') {
      return loadSongsWebdav();
    }
    return loadSongsMeting();
  }

  // ===== WebDAV 音源: 经同源代理 /webdav/* PROPFIND 列目录 → 歌曲列表 =====
  // 坚果云无 CORS 头不能直连: dev 由 astro.config.mjs 中间件转发, 生产由 Cloudflare Pages Function 代理
  async function fetchWebdavSongs(): Promise<Song[]> {
    const wd = MUSIC_CFG.webdav || {};
    if (!wd.url) throw new Error('未配置 WebDAV 地址');
    const dir = (wd.directory || '').replace(/^\/+|\/+$/g, '');
    const pubBase = (wd.publicUrl || '').replace(/\/+$/, '');
    const listUrl = '/webdav/' + dir.split('/').filter(Boolean).map(encodeURIComponent).join('/') + '/';

    // 鉴权由代理服务端注入, 客户端无需携带凭据
    const res = await fetch(listUrl, {
      method: 'PROPFIND',
      headers: {
        Depth: '1',
        'Content-Type': 'application/xml',
      },
      body: '<?xml version="1.0" encoding="UTF-8"?><d:propfind xmlns:d="DAV:"><d:prop><d:resourcetype/></d:prop></d:propfind>',
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const doc = new DOMParser().parseFromString(await res.text(), 'text/xml');
    const responses = Array.from(doc.getElementsByTagNameNS('DAV:', 'response'));

    // 上游服务的 base path (如坚果云 /dav), 用于把返回的 href 映射成 /webdav/ 代理路径
    let basePath = '';
    try { basePath = new URL(wd.url).pathname.replace(/\/+$/, ''); } catch (_) { basePath = ''; }
    const toProxy = (href: string): string => {
      let p = href;
      if (/^https?:\/\//i.test(p)) {
        try { p = new URL(p).pathname; } catch (_) { return ''; }
      }
      if (basePath && p.startsWith(basePath + '/')) p = p.slice(basePath.length);
      return '/webdav' + p;
    };

    type WebdavEntry = { href: string; stem: string; ext: string };
    const entries: WebdavEntry[] = [];
    for (const r of responses) {
      const hrefEl = r.getElementsByTagNameNS('DAV:', 'href')[0];
      if (!hrefEl || !hrefEl.textContent) continue;
      const rt = r.getElementsByTagNameNS('DAV:', 'resourcetype')[0];
      if (rt && rt.getElementsByTagNameNS('DAV:', 'collection').length > 0) continue; // 跳过目录
      const rawName = hrefEl.textContent.split('/').filter(Boolean).pop() || '';
      entries.push({
        href: hrefEl.textContent,
        stem: decodeURIComponent(rawName.replace(/\.[^.]+$/, '')),
        ext: (rawName.match(/\.([^.]+)$/) || [])[1]?.toLowerCase() || '',
      });
    }

    const audioExts = ['mp3', 'flac', 'm4a', 'ogg', 'wav', 'aac', 'opus'];
    const audioEntries = entries
      .filter((e) => audioExts.includes(e.ext))
      .sort((a, b) => a.stem.localeCompare(b.stem, 'zh-CN'));
    if (audioEntries.length === 0) return [];

    // 同名封面图 (jpg/png/webp): 代理模式下 <img> 也能直连 (服务端注入鉴权)
    const coverMap = new Map<string, WebdavEntry>();
    for (const e of entries) {
      if (['jpg', 'jpeg', 'png', 'webp'].includes(e.ext)) coverMap.set(e.stem, e);
    }
    // 通用封面兜底: 目录下 cover/folder/album 图片可作为整目录默认封面
    let genericCover: WebdavEntry | null = null;
    for (const e of entries) {
      if (['jpg', 'jpeg', 'png', 'webp'].includes(e.ext)) {
        const st = e.stem.toLowerCase();
        if (st === 'cover' || st === 'folder' || st === 'album') { genericCover = e; break; }
      }
    }

    // 歌词匹配: 优先同名 .lrc; 文件名不完全一致时按“去符号小写后公共前缀 ≥ 4 字符”兜底
    // (如 "化作孤岛的鲸 不扎.mp3" ↔ "化作孤岛的鲸-蔡明希（不扎）.lrc")
    const lrcEntries = entries.filter((e) => e.ext === 'lrc');
    const normalizeStem = (v: string) =>
      v.replace(/[\s\-–—_·・.。,，、()（）【】\[\]{}「」『』'"~～!！?？:：;；]+/g, '').toLowerCase();
    const matchLrc = (stem: string): WebdavEntry | null => {
      const exact = lrcEntries.find((e) => e.stem === stem);
      if (exact) return exact;
      const ns = normalizeStem(stem);
      if (!ns) return null;
      let best: WebdavEntry | null = null;
      let bestLen = 0;
      for (const lrc of lrcEntries) {
        const nl = normalizeStem(lrc.stem);
        let n = 0;
        while (n < ns.length && n < nl.length && ns[n] === nl[n]) n++;
        // 强匹配: 公共前缀 ≥ 4 字符, 或短方被完整包含 (如 "月亮.lrc" ↔ "月亮 - 胡彦斌.mp3")
        const strong = n >= 4 || (n >= 2 && n === Math.min(ns.length, nl.length));
        if (strong && n > bestLen) { bestLen = n; best = lrc; }
      }
      return best;
    };

    return audioEntries.map((e) => {
      const fileName = e.href.split('/').filter(Boolean).pop() || '';
      // 配置了 publicUrl 直链域名时优先走直链, 否则走同源代理
      const url = pubBase ? pubBase + '/' + fileName : toProxy(e.href);
      // 文件名解析 "歌手 - 歌名"
      let name = e.stem;
      let artist = '--';
      const sep = name.indexOf(' - ');
      if (sep > 0) {
        artist = name.slice(0, sep);
        name = name.slice(sep + 3);
      }
      const cover = coverMap.get(e.stem) || genericCover;
      const pic = cover ? (pubBase ? pubBase + '/' + (cover.href.split('/').filter(Boolean).pop() || '') : toProxy(cover.href)) : '';
      const lrc = matchLrc(e.stem);
      return {
        name, artist, url, pic,
        lrc: lrc ? (pubBase ? pubBase + '/' + (lrc.href.split('/').filter(Boolean).pop() || '') : toProxy(lrc.href)) : '',
      };
    }).filter((s) => s.url);
  }

  async function loadSongsWebdav() {
    if (songs.length > 0) return;
    showStatus('加载歌单中...', false);
    try {
      const newSongs = await fetchWebdavSongs();
      hideStatus();
      if (newSongs.length === 0) {
        showStatus('WebDAV 目录中没有音频文件', true);
        return;
      }
      songs = newSongs;
      cacheSongs();
      const saved = restoreState();
      if (saved) {
        currentIndex = Math.min(saved.currentIndex, songs.length - 1);
        isPlaying = saved.isPlaying;
        setMode(saved.playMode);
        pendingSeek = saved.currentTime;
      }
      const s = songs[currentIndex];
      if (s && $audio) {
        updateSongInfo();
        setAudioSource(s);
      }
      renderList();
      updatePlayBtn();
    } catch (e) {
      hideStatus();
      showStatus('歌单加载失败: ' + (e instanceof Error ? e.message : '网络异常'), true);
      console.warn('[Music] WebDAV 加载歌单失败', e);
    }
  }

  // ===== Meting 音源 (网易云等) =====
  async function loadSongsMeting() {
    if (songs.length > 0 && restoredFromCache) {
      try {
        const url = `${MUSIC_CFG.api || ''}?server=${MUSIC_CFG.server || ''}&type=${MUSIC_CFG.type || ''}&id=${MUSIC_CFG.id || ''}`;
        const res = await fetch(url);
        const data = await res.json();
        const newSongs = (Array.isArray(data) ? data : []).map((it: any) => ({
          name: it.name || it.title || '未知',
          artist: it.artist || it.author || '--',
          url: it.url || '',
          pic: it.pic || it.cover || '',
          lrc: it.lrc || '',
        })).filter((s: Song) => s.url);
        if (newSongs.length > 0) {
          songs = newSongs;
          cacheSongs();
          renderList();
        }
      } catch (_) {}
      return;
    }
    if (songs.length > 0) return;
    showStatus('加载歌单中...', false);
    try {
      const url = `${MUSIC_CFG.api || ''}?server=${MUSIC_CFG.server || ''}&type=${MUSIC_CFG.type || ''}&id=${MUSIC_CFG.id || ''}`;
      const res = await fetch(url);
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      songs = (Array.isArray(data) ? data : []).map((it: any) => ({
        name: it.name || it.title || '未知',
        artist: it.artist || it.author || '--',
        url: it.url || '',
        pic: it.pic || it.cover || '',
        lrc: it.lrc || '',
      })).filter((s: Song) => s.url);
      hideStatus();
      if (songs.length === 0) { showStatus('歌单为空', true); return; }
      cacheSongs();
      const saved = restoreState();
      if (saved) {
        currentIndex = Math.min(saved.currentIndex, songs.length - 1);
        isPlaying = saved.isPlaying;
        setMode(saved.playMode);
        pendingSeek = saved.currentTime;
      }
      const s = songs[currentIndex];
      if (s && $audio) {
        updateSongInfo();
        setAudioSource(s);
      }
      renderList();
      updatePlayBtn();
    } catch (e: any) {
      hideStatus();
      showStatus('歌单加载失败: ' + (e.message || '网络异常'), true);
      console.warn('[Music] 加载歌单失败', e);
    }
  }

  function showStatus(text, isError) {
    const statusEl = document.getElementById('music-status');
    const textEl = document.getElementById('music-status-text');
    if (!statusEl || !textEl) return;
    if (!text) { statusEl.style.display = 'none'; return; }
    textEl.textContent = text;
    statusEl.style.display = 'block';
    statusEl.classList.toggle('is-error', !!isError);
  }
  function hideStatus() {
    const statusEl = document.getElementById('music-status');
    if (statusEl) statusEl.style.display = 'none';
  }

  function setPanelOpen(open: boolean) {
    if (!$panel) return;
    musicPanelIsOpen = open;
    $panel.classList.toggle('is-open', open);
    $panel.setAttribute('aria-hidden', String(!open));
    if (open && songs.length === 0) loadSongs();
  }

  // ===== Audio 事件 (仅绑定一次, audio 元素已 transition:persist) =====
  function bindAudioEvents() {
    if (audioEventsBound || !$audio) return;
    audioEventsBound = true;

    $audio.addEventListener('loadedmetadata', () => {
      if (pendingSeek !== null && pendingSeek > 0 && $audio!.duration && pendingSeek < $audio!.duration) {
        try { $audio!.currentTime = pendingSeek; } catch (_) {}
      }
      pendingSeek = null;
      if (isPlaying) { $audio!.play().catch(() => {}); }
    });
    $audio.addEventListener('timeupdate', () => {
      const cur = $audio!.currentTime;
      const dur = $audio!.duration || 0;
      if ($timeCurEl) $timeCurEl.textContent = formatTime(cur);
      if ($timeDurEl) $timeDurEl.textContent = formatTime(dur);
      const pct = dur > 0 ? (cur / dur) * 100 : 0;
      if ($playedBar) $playedBar.style.width = pct + '%';
      if ($thumbEl) $thumbEl.style.left = pct + '%';
      updateLyric(cur);
    });
    $audio.addEventListener('progress', () => {
      const dur = $audio!.duration || 0;
      if (dur > 0 && $audio!.buffered.length > 0) {
        const buffered = $audio!.buffered.end($audio!.buffered.length - 1);
        if ($loadedBar) $loadedBar.style.width = ((buffered / dur) * 100) + '%';
      }
    });
    $audio.addEventListener('ended', () => { playNext(); });
    $audio.addEventListener('play', () => { isPlaying = true; updatePlayBtn(); });
    $audio.addEventListener('pause', () => { isPlaying = false; updatePlayBtn(); });

    let saveTimer: any = null;
    $audio.addEventListener('timeupdate', () => {
      if (saveTimer) return;
      saveTimer = setTimeout(() => { saveState(); saveTimer = null; }, 2000);
    });

    window.addEventListener('beforeunload', saveState);
    window.addEventListener('pagehide', saveState);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) saveState();
    });
  }

  // ===== document 级监听器 (仅绑定一次) =====
  document.addEventListener('click', (e) => {
    if (!musicPanelIsOpen) return;
    if (Date.now() - lastToggleTime < TOGGLE_GUARD_MS) return;
    const target = e.target as Node;
    if ($popup && !$popup.contains(target) && $musicOpen && !$musicOpen.contains(target)) {
      setPanelOpen(false);
    }
  });
  document.addEventListener('touchstart', (e) => {
    if (!musicPanelIsOpen) return;
    if (Date.now() - lastToggleTime < TOGGLE_GUARD_MS) return;
    const target = e.target as Node;
    if ($popup && !$popup.contains(target) && $musicOpen && !$musicOpen.contains(target)) {
      setPanelOpen(false);
    }
  }, { passive: true });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setPanelOpen(false);
  });

  // ===== 页面级初始化 (UI 绑定, 每次 View Transition 后重新绑定) =====
  // 防重复绑定: 整页首次加载时本函数会被"模块执行"和 astro:page-load 先后各触发一次,
  // 同一 DOM 绑两遍会让点击开关连续 open→close 相互抵消, 表现为面板"点了却弹不出来"
  let boundPanelEl: HTMLElement | null = null;
  function initMusicUI() {
    const panelEl = document.getElementById('music-panel');
    if (panelEl === boundPanelEl) return; // 同一份 DOM 已绑定过 (VT 后 DOM 重建, 会正常重新绑定)
    boundPanelEl = panelEl;
    // 根据 localStorage 开关控制显示
    if (!checkMusicEnabled()) {
      const p = document.getElementById('music-panel');
      const b = document.getElementById('music-open');
      if (p) p.style.display = 'none';
      if (b) b.style.display = 'none';
    }
    $panel = document.getElementById('music-panel');
    $popup = document.getElementById('music-popup');
    $audio = document.getElementById('music-audio') as HTMLAudioElement | null;
    $musicOpen = document.getElementById('music-open');
    $coverImg = document.getElementById('music-cover-img') as HTMLImageElement | null;
    $coverWrap = document.getElementById('music-cover');
    $nameEl = document.getElementById('music-name');
    $artistEl = document.getElementById('music-artist');
    $timeCurEl = document.getElementById('music-time-cur');
    $timeDurEl = document.getElementById('music-time-dur');
    $progressBar = document.getElementById('music-progress');
    $playedBar = document.getElementById('music-played');
    $loadedBar = document.getElementById('music-loaded');
    $thumbEl = document.getElementById('music-thumb');
    $modeBtn = document.getElementById('music-mode');
    $modeIcon = document.getElementById('music-mode-icon');
    $prevBtn = document.getElementById('music-prev');
    $nextBtn = document.getElementById('music-next');
    $playBtn = document.getElementById('music-play');
    $playIcon = document.getElementById('music-play-icon');
    $listBtn = document.getElementById('music-list-btn');
    $listClearBtn = document.getElementById('music-list-clear');
    $playlistWrap = document.getElementById('music-playlist');
    $listBody = document.getElementById('music-list');
    $listCount = document.getElementById('music-list-count');
    $lyricsWrap = document.getElementById('music-lyrics');
    $lyricsBody = document.getElementById('music-lyrics-body');

    // 绑定 audio 事件 (仅首次, audio 已 persist)
    bindAudioEvents();

    // UI 事件 (旧元素随 DOM 销毁, 无需手动移除)
    $musicOpen?.addEventListener('click', (e) => {
      e.preventDefault();
      lastToggleTime = Date.now();
      setPanelOpen(!musicPanelIsOpen);
    });
    $musicOpen?.addEventListener('touchstart', (e) => {
      if (e.cancelable) e.preventDefault();
      lastToggleTime = Date.now();
      setPanelOpen(!musicPanelIsOpen);
    }, { passive: false });
    document.getElementById('music-close')?.addEventListener('click', (e) => {
      e.stopPropagation();
      lastToggleTime = Date.now();
      setPanelOpen(false);
    });

    $playBtn?.addEventListener('click', () => {
      if (!$audio || songs.length === 0) { loadSongs(); return; }
      isPlaying = !isPlaying;
      if (isPlaying) { $audio.play().catch(() => {}); } else { $audio.pause(); }
      updatePlayBtn();
      saveState();
    });
    $prevBtn?.addEventListener('click', () => { playPrev(); saveState(); });
    $nextBtn?.addEventListener('click', () => { playNext(); saveState(); });

    $modeBtn?.addEventListener('click', () => {
      const order: PlayMode[] = ['order', 'loop', 'random'];
      const idx = order.indexOf(playMode);
      setMode(order[(idx + 1) % order.length]);
      saveState();
    });

    function setPlaylistOpen(open: boolean) {
      if (!$playlistWrap || !$listBtn) return;
      if (open) setLyricsOpen(false); // 列表与歌词互斥
      $playlistWrap.hidden = !open;
      $listBtn.classList.toggle('is-active', open);
    }
    function setLyricsOpen(open: boolean) {
      if (!$lyricsWrap) return;
      lyricsOpen = open;
      if (open && $playlistWrap && !$playlistWrap.hidden) {
        $playlistWrap.hidden = true;
        $listBtn?.classList.remove('is-active');
      }
      $lyricsWrap.hidden = !open;
    }
    $listBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      setPlaylistOpen(!!$playlistWrap?.hidden);
    });
    $listClearBtn?.addEventListener('click', () => setPlaylistOpen(false));

    // 点击歌名区域展开/收起歌词
    document.getElementById('music-song-info')?.addEventListener('click', () => {
      setLyricsOpen(!lyricsOpen);
    });
    // 点击歌词行跳转播放进度
    $lyricsBody?.addEventListener('click', (e) => {
      const line = (e.target as HTMLElement).closest('.music-lyrics-line') as HTMLElement | null;
      if (!line || !$audio) return;
      const idx = parseInt(line.getAttribute('data-idx') || '-1', 10);
      if (idx >= 0 && idx < lyricLines.length) {
        try { $audio.currentTime = lyricLines[idx].t; } catch (_) {}
      }
    });

    $listBody?.addEventListener('click', (e) => {
      const item = (e.target as HTMLElement).closest('.music-list-item') as HTMLElement | null;
      if (!item) return;
      e.stopPropagation();
      const idx = parseInt(item.getAttribute('data-idx') || '0', 10);
      if (idx >= 0 && idx < songs.length) loadSong(idx, true);
    });

    $progressBar?.addEventListener('click', (e) => {
      if (!$audio || !$audio.duration) return;
      const rect = $progressBar.getBoundingClientRect();
      const pct = (e.clientX - rect.left) / rect.width;
      $audio.currentTime = pct * $audio.duration;
      saveState();
    });

    // 恢复 UI 状态 (覆盖等信息会在 View Transition 后丢失, 需要重新设置)
    const songIdx = currentIndex;
    if (songIdx >= 0 && songIdx < songs.length) {
      updateSongInfo();
    }
    updatePlayBtn();
    renderList();
    // 恢复歌词视图 (VT 后 DOM 重建, 模块级歌词数据仍在)
    renderLyrics();
    if ($lyricsWrap) $lyricsWrap.hidden = !lyricsOpen;
    if (musicPanelIsOpen) {
      $panel?.classList.add('is-open');
      $panel?.setAttribute('aria-hidden', 'false');
    }
  }

  // ===== 初始化 =====
  // 1. 绑定 UI
  initMusicUI();
  // 2. 恢复播放状态 (图标立即旋转)
  const savedInit = restoreState();
  if (savedInit) {
    currentIndex = Math.min(savedInit.currentIndex, 999);
    isPlaying = savedInit.isPlaying;
    setMode(savedInit.playMode);
  }
  setMode(playMode);
  updatePlayBtn();
  // 3. 仅当音乐开关开启时才加载歌单 (sessionStorage 缓存命中则跳过重复请求)
  if (checkMusicEnabled()) {
    if (!restoreFromCache()) {
      loadSongs();
    }
  }

  // 4. 监听设置面板发来的"音乐已启用"事件
  window.addEventListener('sumyu:music-enabled', () => {
    if (songs.length === 0) loadSongs();
    // 显示按钮和面板（applyMusic 可能执行时元素还未就绪）
    const p = document.getElementById('music-panel');
    const b = document.getElementById('music-open');
    if (p) p.style.display = '';
    if (b) b.style.display = '';
    // 自动弹出播放器
    setPanelOpen(true);
  });

  // View Transition 后仅重新绑定 UI (audio 持续播放)
  document.addEventListener('astro:page-load', initMusicUI);
</script>

