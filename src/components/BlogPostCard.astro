---
import { formatDate, readingTime } from '@/utils/posts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const url = `/posts/${post.id}/`;
const showImage = post.data.showImage && post.data.image;
const minutes = (post.data as any).readingMinutes ?? 3;
const isEncrypted = post.data.encrypted;
---

<article class={`blog-card${post.data.pinned ? ' is-pinned' : ''}`}>
  {showImage && (
    <a class="blog-card__cover" href={url}>
      <img src={post.data.image} alt={post.data.title} loading="lazy" decoding="async" />
    </a>
  )}
  <div class="blog-card__body">
    {post.data.pinned && (
      <span class="blog-card__pinned">
        <iconify-icon icon="mdi:pin" aria-hidden="true"></iconify-icon>
        置顶
      </span>
    )}
    <div class="blog-card__meta">
      <span class="blog-card__date">
        <iconify-icon icon="mdi:calendar-outline" aria-hidden="true"></iconify-icon>
        {formatDate(post.data.pubDate)}
      </span>
      <span class="blog-card__category">
        <iconify-icon icon="mdi:folder-outline" aria-hidden="true"></iconify-icon>
        {post.data.category}
      </span>
      <span class="blog-card__reading">
        <iconify-icon icon="mdi:clock-outline" aria-hidden="true"></iconify-icon>
        {readingTime(minutes)}
      </span>
      {isEncrypted && (
        <span class="blog-card__lock">
          <iconify-icon icon="mdi:lock" aria-hidden="true"></iconify-icon>
          加密
        </span>
      )}
    </div>
    <h2 class="blog-card__title">
      <a href={url}>{post.data.title}</a>
    </h2>
    {post.data.description && (
      <p class="blog-card__excerpt">{post.data.description}</p>
    )}
    {post.data.tags.length > 0 && (
      <div class="blog-card__tags">
        {post.data.tags.map(t => (
          <a class="blog-card__tag" href={`/tags/?tag=${encodeURIComponent(t)}`}>#{t}</a>
        ))}
      </div>
    )}
  </div>
  <a class="blog-card__readmore" href={url} aria-label={`阅读：${post.data.title}`}>
    <iconify-icon icon="ri:arrow-right-line"></iconify-icon>
  </a>
</article>

<style>
  .blog-card {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    gap: 20px;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 16px;
    transition: all var(--transition-base);
    position: relative;
  }
  .blog-card:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-pink);
    border-color: var(--sakura-primary-soft);
  }

  .blog-card__cover {
    display: block; width: 200px; height: 130px;
    overflow: hidden; border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }
  .blog-card__cover img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--transition-base);
  }
  .blog-card:hover .blog-card__cover img { transform: scale(1.06); }

  .blog-card__body { min-width: 0; display: flex; flex-direction: column; gap: 6px; }

  /* 置顶徽章 */
  .blog-card__pinned {
    display: inline-flex; align-items: center; gap: 4px;
    align-self: flex-start;
    font-size: 11px; color: #fff;
    background: var(--sakura-primary);
    padding: 2px 10px; border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
  }
  .blog-card__pinned iconify-icon { font-size: 13px; }

  /* 置顶卡片: 左侧加粉色边框高亮 */
  .blog-card.is-pinned {
    border-left: 4px solid var(--sakura-primary);
    background: linear-gradient(90deg, var(--sakura-primary-bg) 0%, var(--bg-card) 30%);
  }
  .blog-card.is-pinned:hover {
    border-left-color: var(--sakura-primary-deep);
  }

  .blog-card__meta {
    display: flex; flex-wrap: wrap; gap: 12px;
    font-size: 12px; color: var(--text-muted);
  }
  .blog-card__meta span { display: inline-flex; align-items: center; gap: 4px; }
  .blog-card__meta iconify-icon { font-size: 14px; }
  .blog-card__lock { color: var(--sakura-primary); }

  .blog-card__title { font-size: 18px; line-height: 1.4; margin-top: 2px; }
  .blog-card__title a { color: var(--text-strong); }
  .blog-card__title a:hover { color: var(--sakura-primary); }

  .blog-card__excerpt {
    font-size: 13px; color: var(--text-muted); line-height: 1.7;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }

  .blog-card__tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 4px; }
  .blog-card__tag {
    font-size: 11px; color: var(--sakura-primary);
    background: var(--sakura-primary-bg);
    padding: 2px 8px; border-radius: var(--radius-full);
    transition: all var(--transition-fast);
  }
  .blog-card__tag:hover { background: var(--sakura-primary); color: #fff; }

  .blog-card__readmore {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: 50%;
    color: var(--text-muted); font-size: 18px;
    background: var(--bg-soft);
    transition: all var(--transition-fast);
  }
  .blog-card__readmore:hover {
    background: var(--sakura-primary); color: #fff;
    transform: translateX(2px);
  }

  /* 无图时调整布局 */
  .blog-card:not(:has(.blog-card__cover)) {
    grid-template-columns: 1fr auto;
  }

  /* 网格模式 */
  .is-grid .blog-card {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .is-grid .blog-card__cover {
    width: 100%; height: 160px;
  }
  .is-grid .blog-card__readmore {
    position: absolute; bottom: 12px; right: 12px;
  }
  .is-grid .blog-card:not(:has(.blog-card__cover)) {
    grid-template-columns: 1fr auto;
  }

  @media (max-width: 768px) {
    .blog-card {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .blog-card__cover { width: 100%; height: 180px; }
    .blog-card__readmore { display: none; }
    .blog-card__title { font-size: 16px; }
  }
</style>
