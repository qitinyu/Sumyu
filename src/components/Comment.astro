---
import { COMMENT } from '@/config';
interface Props {
  // 当前页面唯一标识 (用于区分不同文章的评论), 留空则使用 pathname
  // 优先级: pageId (显式传入的 comment_id) > key > pathname
  // 当使用 yuamli 系统时, pageId 会作为 ?pageId=xxx 拼到 iframe URL 上,
  // 让每篇文章拥有独立的留言区
  key?: string;
  pageId?: string;
}
const { key = '', pageId = '' } = Astro.props;
const commentKey = key || Astro.url.pathname;
// yuamli iframe 的 pageId 参数: 优先使用显式传入的 pageId, 否则用 commentKey
const yuamliPageId = pageId || commentKey;
// 拼接 yuamli iframe URL: ?pageId=xxx
// 本地开发时优先指向本地 yuamli (localhost:3000)，便于预览 embed 新体验；生产走线上地址
const yuamliBaseUrl = import.meta.env.DEV ? 'http://localhost:3000/' : COMMENT.yuamli.url;
const yuamliSeparator = yuamliBaseUrl.includes('?') ? '&' : '?';
const yuamliFrameSrc = yuamliBaseUrl + yuamliSeparator + 'pageId=' + encodeURIComponent(yuamliPageId) + '&embed=1';
---

{COMMENT.enable && (
  <section class="post-comment" id="post-comment" data-system={COMMENT.system} data-key={commentKey} data-page-id={yuamliPageId}>
    <h3 class="post-comment__title">
      <iconify-icon icon="mdi:comment-text-multiple-outline" aria-hidden="true"></iconify-icon>
      评论
    </h3>
    <div class="post-comment__body" id="comment-container">
      <!-- yuamli: iframe 嵌入 (pageId 参数实现每篇文章独立留言区) -->
      {COMMENT.system === 'yuamli' && (
        <iframe
          class="comment-yuamli"
          id="comment-yuamli-frame"
          src={yuamliFrameSrc}
          loading="lazy"
          allow="fullscreen"
        ></iframe>
      )}

      <!-- twikoo: 客户端 div -->
      {COMMENT.system === 'twikoo' && (
        <div id="tcomment"></div>
      )}

      <!-- giscus: 通过 script 嵌入 -->
      {COMMENT.system === 'giscus' && (
        <div class="giscus"></div>
      )}

      <!-- 未知系统 -->
      {!['yuamli', 'twikoo', 'giscus'].includes(COMMENT.system) && (
        <div class="comment-unknown">
          <p>未知的评论系统: {COMMENT.system}</p>
          <p>请在 <code>src/config.ts</code> 的 <code>COMMENT.system</code> 中选择 'yuamli' / 'giscus' / 'twikoo' 之一</p>
        </div>
      )}
    </div>
  </section>
)}

<!-- 客户端脚本: yuamli 高度自适应 + 主题同步（实现见 src/scripts/yuamli-embed.ts） -->
{/* yuamli iframe 宿主侧：高度自适应（只跟内容高度，不按视口补高）+ 主题/字体同步。
    注意：Astro 不会打包这里带 import 的脚本，逻辑只能内联（与 pages/comment.astro 保持一致）。 */}
<script data-astro-rerun>
  (function () {
    var FRAME_ID = "comment-yuamli-frame";
    var MIN_H = 250; // 高度下限：加载中/内容瞬间为空时别把 iframe 压成一条缝
    var prev = window.__yuamliEmbed;
    if (prev) {
      window.removeEventListener("message", prev.onMessage);
      window.removeEventListener("message", prev.onReady);
      window.removeEventListener("orientationchange", prev.onResize);
      window.removeEventListener("resize", prev.onResize);
      prev.mo.disconnect();
    }

    var frame = document.getElementById(FRAME_ID);
    if (!frame) { window.__yuamliEmbed = null; return; }

    // ---- 明暗主题 / 强调色 / 正文字体 推给 iframe ----
    var readConfig = function () {
      var root = document.documentElement;
      var cs = getComputedStyle(root);
      var isDark = root.classList.contains("dark");
      var accent = (cs.getPropertyValue("--sakura-primary") || "").trim() || "#DF9193";
      var fontBody = getComputedStyle(document.body).fontFamily || "";
      return { type: "yuamli:config", theme: isDark ? "dark" : "light", accent: accent, fontBody: fontBody };
    };
    var sendConfig = function () {
      try { frame.contentWindow.postMessage(readConfig(), "*"); } catch (e) { /* 跨域异常忽略 */ }
    };

    // ---- 高度策略 ----
    // 只跟随 iframe 上报的内容高度，不再按"剩余视口高度"补满，且允许变矮。
    // 真实高度到手前由 CSS 的 min-height 兜底；到手后打 data-measured 撤掉兜底，避免底部留白。
    var contentHeight = 0;
    var appliedHeight = 0;
    var applyHeight = function () {
      if (!contentHeight || contentHeight === appliedHeight) return;
      appliedHeight = contentHeight;
      frame.style.height = Math.max(contentHeight, MIN_H) + "px";
      frame.dataset.measured = "1";
    };
    var onMessage = function (e) {
      var d = e.data;
      if (!d || d.type !== "yuamli:height") return;
      var h = parseInt(d.height, 10);
      if (h > 0) { contentHeight = h; applyHeight(); }
    };
    var onReady = function (e) {
      if (e.data && e.data.type === "yuamli:ready" && e.source === frame.contentWindow) sendConfig();
    };
    // 窗口尺寸变化：iframe 宽度变了内容会重排，yuamli 会重新上报；这里只清掉已应用值，避免闪烁
    var onResize = function () { appliedHeight = 0; };

    window.addEventListener("message", onMessage);
    window.addEventListener("message", onReady);
    window.addEventListener("orientationchange", onResize);
    window.addEventListener("resize", onResize);
    if (document.readyState === "complete") applyHeight();
    else window.addEventListener("load", function () { applyHeight(); }, { once: true });

    // 主题 / 主题色切换后重新同步给 iframe
    var mo = new MutationObserver(sendConfig);
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ["class", "data-theme-color"] });

    window.__yuamliEmbed = { onMessage: onMessage, onReady: onReady, onResize: onResize, mo: mo };
  })();
</script>

{COMMENT.enable && COMMENT.system === 'twikoo' && (
  <script data-astro-rerun>
    // ---- 加载 Twikoo ----
    // 数据从 Astro 服务端注入到全局变量
    const TWIKOO_CFG = {
      envId: 'https://netlify-nt.netlify.app/.netlify/functions/twikoo',
      lang: 'zh-CN',
      version: '1.7.10',
      cdn: 'https://s4.zstatic.net/npm/twikoo@{version}/dist/twikoo.min.js',
      fallbackCdn: 'https://registry.npmmirror.com/twikoo@{version}/files/dist/twikoo.min.js',
    };

    function loadScript(src: string): Promise<void> {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src;
        s.defer = true;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('Failed: ' + src));
        document.head.appendChild(s);
      });
    }

    function initTwikoo() {
      const el = document.getElementById('tcomment');
      // @ts-ignore
      if (!el || !window.twikoo) return;
      try {
        // @ts-ignore
        window.twikoo.init({
          envId: TWIKOO_CFG.envId,
          el: '#tcomment',
          lang: TWIKOO_CFG.lang,
        });
      } catch (e) {
        console.warn('[Twikoo] 初始化失败:', e);
      }
    }

    async function loadTwikoo() {
      const cdn = TWIKOO_CFG.cdn.replace('{version}', TWIKOO_CFG.version);
      const fallback = TWIKOO_CFG.fallbackCdn.replace('{version}', TWIKOO_CFG.version);
      try {
        await loadScript(cdn);
      } catch (_) {
        try {
          await loadScript(fallback);
        } catch (e) {
          console.warn('[Twikoo] CDN 加载失败:', e);
          return;
        }
      }
      initTwikoo();
    }

    // 进入视口后再加载
    const commentSection = document.getElementById('post-comment');
    if (commentSection) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            loadTwikoo();
            io.disconnect();
          }
        });
      }, { rootMargin: '200px' });
      io.observe(commentSection);
      // 备用: 5 秒后强制加载
      setTimeout(() => {
        // @ts-ignore
        if (!window.twikoo) loadTwikoo();
      }, 5000);
    }
  </script>
)}

{COMMENT.enable && COMMENT.system === 'giscus' && (
  <script data-astro-rerun>
    // ---- 加载 Giscus ----
    const GISCUS_CFG = {
      repo: 'qitinyu/yuami-giscus',
      repoId: 'R_kgDOSmXsaA',
      category: 'Announcements',
      categoryId: 'DIC_kwDOSmXsaM4C9uxi',
      mapping: 'pathname',
      strict: '1',
      reactionsEnabled: '1',
      emitMetadata: '0',
      inputPosition: 'top',
      theme: 'noborder_light',
      lang: 'zh-CN',
      loading: 'lazy',
    };

    function loadGiscus() {
      const container = document.querySelector('.giscus');
      if (!container) return;
      // 已加载则不重复
      if (container.querySelector('iframe.giscus-frame')) return;

      const s = document.createElement('script');
      s.src = 'https://giscus.app/client.js';
      s.setAttribute('data-repo', GISCUS_CFG.repo);
      s.setAttribute('data-repo-id', GISCUS_CFG.repoId);
      s.setAttribute('data-category', GISCUS_CFG.category);
      s.setAttribute('data-category-id', GISCUS_CFG.categoryId);
      s.setAttribute('data-mapping', GISCUS_CFG.mapping);
      s.setAttribute('data-strict', GISCUS_CFG.strict);
      s.setAttribute('data-reactions-enabled', GISCUS_CFG.reactionsEnabled);
      s.setAttribute('data-emit-metadata', GISCUS_CFG.emitMetadata);
      s.setAttribute('data-input-position', GISCUS_CFG.inputPosition);
      s.setAttribute('data-theme', GISCUS_CFG.theme);
      s.setAttribute('data-lang', GISCUS_CFG.lang);
      s.setAttribute('data-loading', GISCUS_CFG.loading);
      s.crossOrigin = 'anonymous';
      s.async = true;
      container.appendChild(s);
    }

    const commentSection = document.getElementById('post-comment');
    if (commentSection) {
      if (GISCUS_CFG.loading === 'lazy') {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              loadGiscus();
              io.disconnect();
            }
          });
        }, { rootMargin: '200px' });
        io.observe(commentSection);
      } else {
        loadGiscus();
      }
    }
  </script>
)}

<style>
  .post-comment {
    margin-top: 56px;
    padding: 24px 28px;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .post-comment__title {
    font-size: 18px;
    color: var(--text-strong);
    margin-bottom: 18px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border-soft);
    width: 100%;
  }
  .post-comment__title iconify-icon { color: var(--sakura-primary); font-size: 22px; }

  .post-comment__body { min-height: 80px; }

  /* yuamli iframe（嵌入模式：透明背景 + 高度自适应，视觉与博客融合）
     兜底 min-height 600px：仅在 iframe 还没上报真实高度时生效，避免首帧塌成一条缝 */
  .comment-yuamli {
    width: 100%;
    min-height: 600px;
    border: none;
    border-radius: var(--radius-md);
    background: transparent;
    display: block;
  }

  /* 已收到 yuamli 上报的真实高度：撤掉 600px 兜底，高度完全跟内容走，底下不再留白 */
  .comment-yuamli[data-measured='1'] {
    min-height: 0;
  }

  /* twikoo 样式适配 */
  .post-comment__body :global(.twikoo) {
    background: var(--bg-card);
    color: var(--text-base);
  }
  .post-comment__body :global(.twikoo .tk-input) .el-input__inner,
  .post-comment__body :global(.twikoo input),
  .post-comment__body :global(.twikoo textarea) {
    background: var(--bg-soft) !important;
    color: var(--text-strong) !important;
    border-color: var(--border-color) !important;
  }
  .post-comment__body :global(.twikoo .tk-submit button) {
    background: var(--sakura-primary) !important;
    border-color: var(--sakura-primary) !important;
  }
  .post-comment__body :global(.tk-content),
  .post-comment__body :global(.tk-nick),
  .post-comment__body :global(.tk-meta) {
    color: var(--text-base) !important;
  }

  /* giscus 容器 */
  .post-comment__body :global(.giscus) {
    min-height: 200px;
  }
  .post-comment__body :global(.giscus iframe) {
    width: 100%;
    border: none;
  }

  /* 未知系统提示 */
  .comment-unknown {
    text-align: center;
    padding: 24px;
    color: var(--text-muted);
  }
  .comment-unknown p { margin: 6px 0; font-size: 13px; }
  .comment-unknown code {
    background: var(--bg-soft); padding: 2px 6px; border-radius: 4px;
    font-size: 12px; color: var(--sakura-primary);
  }

  @media (max-width: 768px) {
    /* 移动端(yuamli 嵌入): 评论区铺满整张卡片 —— 左右齐边、标题下方不留间距、
       底部不留内边距, 时间距只由 yuamli 自身的内部留白决定 */
    .post-comment[data-system='yuamli'] {
      padding: 18px 0 0;
      margin-top: 36px;
      overflow: hidden; /* 让 iframe 被卡片圆角裁切 */
    }
    .post-comment[data-system='yuamli'] .post-comment__title {
      margin-bottom: 0;
      padding: 0 16px 12px; /* 标题文字保留左右内边距, 分割线仍然通栏 */
    }
    .post-comment[data-system='yuamli'] .comment-yuamli { border-radius: 0; }

    .post-comment:not([data-system='yuamli']) { padding: 18px 16px; margin-top: 36px; }
  }
</style>
